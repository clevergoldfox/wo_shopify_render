{{ 'tsl-page.css' | asset_url | stylesheet_tag }}
<script src="{{ 'tsl-page.js' | asset_url }}" defer></script>

<div class="tsl tsl-roadmap tsl-reveal" style="background-color: {{ section.settings.bg }};">
  {%- if section.settings.heading != blank -%}
    <div class="tsl-roadmap__header">
      <h2 class="tsl__heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="tsl__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="tsl-roadmap__timeline" data-tsl-roadmap>
    <div class="tsl-roadmap__fill"></div>
    {%- for block in section.blocks -%}
      <div class="tsl-roadmap__item" {{ block.shopify_attributes }}>
        <span class="tsl-roadmap__circle">{% render 'tsl-icon', icon: 'check' %}</span>
        {%- if block.settings.badge != blank -%}
          <span class="tsl-roadmap__badge">{{ block.settings.badge }}</span>
        {%- endif -%}
        <h3 class="tsl-roadmap__title">{{ block.settings.title }}</h3>
        <div class="tsl-roadmap__text">{{ block.settings.text }}</div>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "TSL Roadmap",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Su Viaje Hacia un Usted Mejor" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Los cambios reales ocurren gradualmente. Así es como suele desarrollarse." },
    { "type": "color", "id": "bg", "label": "Background", "default": "#f8f8f8" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "badge", "label": "Badge" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "richtext", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [{ "name": "TSL Roadmap" }]
}
{% endschema %}
