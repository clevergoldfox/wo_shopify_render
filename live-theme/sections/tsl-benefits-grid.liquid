{{ 'tsl-page.css' | asset_url | stylesheet_tag }}
<script src="{{ 'tsl-page.js' | asset_url }}" defer></script>

<div class="tsl tsl-benefits tsl-reveal" style="background-color: {{ section.settings.bg }};">
  {%- if section.settings.heading != blank -%}
    <div class="tsl-benefits__header">
      <h2 class="tsl__heading">
        {{ section.settings.heading }}
        {%- if section.settings.heading_accent != blank -%}
          <span class="tsl__accent">{{ section.settings.heading_accent }}</span>
        {%- endif -%}
      </h2>
      {%- if section.settings.subheading != blank -%}
        <p class="tsl__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="tsl-benefits__items">
    {%- for block in section.blocks -%}
      <div class="tsl-benefit" {{ block.shopify_attributes }}>
        {%- if block.settings.icon != blank -%}
          <div class="tsl-benefit__icon">
            {{ block.settings.icon | image_url: width: 400 | image_tag:
               loading: 'lazy', alt: block.settings.title, widths: '200,300,400' }}
          </div>
        {%- endif -%}
        <h3 class="tsl-benefit__title">{{ block.settings.title }}</h3>
        {%- if block.settings.text != blank -%}
          <p class="tsl-benefit__text">{{ block.settings.text }}</p>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "TSL Benefits grid",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "heading_accent", "label": "Accent heading" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#ffffff" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Icon" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [{ "name": "TSL Benefits grid" }]
}
{% endschema %}
