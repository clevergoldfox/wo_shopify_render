      <div>
    <!-- ============================================= -->
<!-- VERNU · BANNER ÚLTIMOS DÍAS DE HOT SALE       -->
<!-- Cuenta atrás hasta las 23:59:59 de HOY        -->
<!-- (hora del navegador del usuario)              -->
<!-- Pegar en GemPages como bloque HTML/Liquid     -->
<!-- ============================================= -->
<div id="vernu-hotsale-bar" style="
    width:100%;
    background:#0D2E6E;
    color:#ffffff;
    font-family:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
    padding:10px 16px;
    box-sizing:border-box;
    display:flex;
    align-items:center;
    justify-content:center;
    gap:14px;
    flex-wrap:wrap;
    text-align:center;
    line-height:1.2;
">

  <!-- Texto principal -->
  <span class="hs-main" style="font-size:15px;font-weight:800;letter-spacing:0.3px;">
    OFERTA ESPECIAL · SOLO HOY
  </span>

  <!-- Separador (oculto en móvil) -->
  <span class="vernu-hotsale-sep" style="opacity:0.5;font-weight:300;">|</span>

  <!-- Countdown -->
  <span class="hs-cd" style="font-size:14px;font-weight:600;display:inline-flex;align-items:center;gap:8px;">
    <span style="opacity:0.85;font-weight:500;">Termina en</span>
    <span id="vernu-hotsale-timer" style="
        font-variant-numeric:tabular-nums;
        font-weight:800;
        letter-spacing:0.5px;
        background:rgba(255,255,255,0.12);
        padding:3px 10px;
        border-radius:6px;
        min-width:78px;
        display:inline-block;
    ">00:00:00</span>
  </span>

</div>

<style>
  @media (max-width:600px){
    #vernu-hotsale-bar{ gap:8px; padding:9px 12px; }
    #vernu-hotsale-bar .hs-main{ font-size:13px !important; }
    #vernu-hotsale-bar .hs-cd{ font-size:12px !important; }
    .vernu-hotsale-sep{ display:none !important; }
  }
</style>

<script>
(function(){
  function tick(){
    var now = new Date();
    // Fin del día de hoy a las 23:59:59.999 hora del navegador del usuario
    var end = new Date(now.getFullYear(), now.getMonth(), now.getDate(), 23, 59, 59, 999);

    var diff = end - now;
    if(diff < 0) diff = 0;

    var h = Math.floor(diff / 3600000);
    var m = Math.floor((diff % 3600000) / 60000);
    var s = Math.floor((diff % 60000) / 1000);

    var pad = function(n){ return (n < 10 ? '0' : '') + n; };
    var el = document.getElementById('vernu-hotsale-timer');
    if(el){ el.textContent = pad(h) + ':' + pad(m) + ':' + pad(s); }
  }
  tick();
  setInterval(tick, 1000);
})();
</script>
