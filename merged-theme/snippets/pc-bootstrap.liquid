{%- comment -%}
  Everything the PrimeCell page needs, loaded only on its own template.

  The stylesheets are Bootstrap 4 and a Checkout Champ funnel theme. Both are global by
  nature -- they style html, body, *, .container, .row, .btn -- so every rule has been
  rewritten to sit under .pc-scope, a class each pc-* section carries via its schema.
  html/body/:root rules become .pc-scope itself rather than ".pc-scope html", which
  would never match.

  jQuery, Popper, Bootstrap's JS and Swiper are the page's own dependencies; this theme
  ships none of them, so there is nothing to collide with.
{%- endcomment -%}
<link rel="stylesheet" href="{{ 'pc-bootstrap.min.css' | asset_url }}" media="all">
<link rel="stylesheet" href="{{ 'pc-all.min.css' | asset_url }}" media="all">
<link rel="stylesheet" href="{{ 'pc-animate.min.css' | asset_url }}" media="all">
<link rel="stylesheet" href="{{ 'pc-swiper-bundle.min.css' | asset_url }}" media="all">
<link rel="stylesheet" href="{{ 'pc-css.css' | asset_url }}" media="all">
<link rel="stylesheet" href="{{ 'pc-css-1.css' | asset_url }}" media="all">
<link rel="stylesheet" href="{{ 'pc-css-2.css' | asset_url }}" media="all">
<link rel="stylesheet" href="{{ 'pc-css-3.css' | asset_url }}" media="all">
<link rel="stylesheet" href="{{ 'pc-core.min.css' | asset_url }}" media="all">
{% render 'pc-inline-css' %}
<script src="{{ 'pc-jquery-3.5.1.min.js' | asset_url }}"></script>
<script src="{{ 'pc-popper.min.js' | asset_url }}"></script>
<script src="{{ 'pc-bootstrap.min.js' | asset_url }}"></script>
<script src="{{ 'pc-swiper-bundle.min.js' | asset_url }}"></script>

{%- comment -%}
  The buy box: the funnel posted to Checkout Champ, pc-cart.js posts to this cart.
{%- endcomment -%}
<script>
  window.PC_ADD_URL  = {{ routes.cart_add_url | json }};
  window.PC_CART_URL = {{ routes.cart_url | json }};
  window.PC_PRODUCT  = {
    id: {{ product.id | json }},
    variants: [
      {%- for v in product.variants -%}
      {
        id: {{ v.id | json }},
        title: {{ v.title | json }},
        available: {{ v.available | json }},
        price: {{ v.price | money | json }},
        compare_at_price: {{ v.compare_at_price | money | json }}
      }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  };
</script>
<script src="{{ 'pc-cart.js' | asset_url }}" defer></script>
