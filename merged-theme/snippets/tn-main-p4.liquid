  <span style="font-size: 18px;">ⓘ</span>
  Order within 
  <span id="countdown"><strong>14 min</strong> and <strong>43 sec</strong></span>
  to get it between 
  <strong><span id="start-date">Tuesday, September 1</span></strong> and 
  <strong><span id="end-date">Friday, September 4</span></strong>.
</div>

<script>
  // Countdown logic
  let duration = 15 * 60; // 15 minutes in seconds
  const countdownEl = document.getElementById("countdown");

  const timer = setInterval(() => {
    let minutes = Math.floor(duration / 60);
    let seconds = duration % 60;
    countdownEl.innerHTML = `<strong>${minutes} min</strong> and <strong>${seconds < 10 ? '0' : ''}${seconds} sec</strong>`;
    duration--;

    if (duration < 0) clearInterval(timer);
  }, 1000);

  // Date logic
  const formatDate = (date) => {
    const options = { weekday: 'long', month: 'long', day: 'numeric' };
    return date.toLocaleDateString('en-US', options);
  };

  const today = new Date();
  const start = new Date(today);
  start.setDate(start.getDate() + 3); // +3 days
  const end = new Date(today);
  end.setDate(end.getDate() + 6); // +6 days

  document.getElementById("start-date").textContent = formatDate(start);
  document.getElementById("end-date").textContent = formatDate(end);
</script>



