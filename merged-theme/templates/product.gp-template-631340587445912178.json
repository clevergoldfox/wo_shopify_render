        "ggp_gJykmM4_text": "<p>☀️</p>",
        "ggtqnKyekc6_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/1001/1086/0617/files/ChatGPT_Image_4_ago_2026_18_58_16_05ec9f79-a256-4d22-a460-72c544624249.png",
        "ggtqnKyekc6_srcSet_mobile_src": "https://cdn.shopify.com/s/files/1/1001/1086/0617/files/ChatGPT_Image_4_ago_2026_18_58_16_05ec9f79-a256-4d22-a460-72c544624249.png",
        "gguToze2YZt_text": "<p>Fresh</p>",
        "ggusuJcAvfI_text": "\"I've spent hundreds on serums that did nothing. This is the first one my skin actually drank in. Softer, firmer, brighter every morning.\"",
