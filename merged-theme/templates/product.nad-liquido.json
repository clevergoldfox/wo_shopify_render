    "custom_liquid_hVGUtb": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "display_id": false,
        "visibility": "always-display",
        "custom_liquid": "<section class=\"yl-reviews-section\">\n  <style>\n    .yl-reviews-section {\n      font-family: Arial, sans-serif;\n      background-color: #f5fdf5;\n      margin: 0;\n      padding: 1px 0 0;\n    }\n\n    .yl-reviews-section h1.d3FsH6IqT4 {\n      margin-top: 30px;\n      font-size: 26px;\n      font-weight: bold;\n      color: #333;\n      text-align: center;\n      line-height: 1.25;\n      padding: 0 16px;\n    }\n\n    .yl-reviews-section h1 .AaB2Y5Gp9f {\n      background: linear-gradient(to bottom, #28a745 0%, #d3f9d8 100%);\n      -webkit-background-clip: text;\n      color: transparent;\n    }\n\n    .yl-reviews-section p.RwV2N5Lt0I {\n      margin-top: 5px;\n      font-size: 16px;\n      color: #555;\n      text-align: center;\n      padding: 0 16px;\n    }\n\n    .yl-reviews-section .LaVtZ1Q0xK {\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      font-family: Arial, sans-serif;\n      font-size: 14px;\n      color: #333;\n      margin-top: 10px;\n      flex-wrap: wrap;\n      gap: 8px;\n      padding: 0 16px;\n      text-align: center;\n    }\n\n    .yl-reviews-section .KsF9M8H2Ej {\n      display: flex;\n      align-items: center;\n      margin-right: 10px;\n    }\n\n    .yl-reviews-section .KsF9M8H2Ej img {\n      max-width: 100px;\n      width: 100px;\n      height: auto;\n    }\n\n    .yl-reviews-section .jX4N5P7Dr6 {\n      font-weight: normal;\n    }\n\n    .yl-reviews-section .Yk4V8N6Vf1 {\n      font-weight: bold;\n    }\n\n    .yl-reviews-section .F0rW6K8yEz {\n      display: flex;\n      flex-wrap: nowrap;\n      gap: 20px;\n      overflow-x: auto;\n      padding: 20px;\n      margin: 20px auto;\n      width: 90%;\n      box-sizing: border-box;\n      scroll-snap-type: x mandatory;\n      -webkit-overflow-scrolling: touch;\n    }\n\n    .yl-reviews-section .nQ0V3S1vD7 {\n      background-color: white;\n      border-radius: 8px;\n      padding: 20px;\n      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);\n      text-align: left;\n      position: relative;\n      border-left: 4px solid #28a745;\n      width: 400px;\n      flex-shrink: 0;\n      scroll-snap-align: start;\n    }\n\n    .yl-reviews-section .nQ0V3S1vD7 .Fb0W9T8TjZ {\n      font-weight: bold;\n      margin-bottom: 5px;\n      font-size: 14px;\n      color: #333;\n    }\n\n    .yl-reviews-section .nQ0V3S1vD7 .rT9B3G2MdF {\n      font-size: 12px;\n      color: #777;\n      margin-bottom: 15px;\n    }\n\n    .yl-reviews-section .nQ0V3S1vD7 .gP9Z3A2Kn7 {\n      font-size: 14px;\n      color: #555;\n      margin-bottom: 15px;\n      line-height: 1.6;\n    }\n\n    .yl-reviews-section .nQ0V3S1vD7 .Vh3J2R4Nw1 {\n      font-size: 12px;\n      color: #28a745;\n      font-weight: bold;\n    }\n\n    .yl-reviews-section .nQ0V3S1vD7 .Bz5W3F7Wz2 {\n      margin-top: 10px;\n      display: flex;\n      gap: 2px;\n    }\n\n    .yl-reviews-section .Bz5W3F7Wz2 svg {\n      width: 16px;\n      height: 16px;\n      fill: #28a745;\n    }\n\n    .yl-reviews-section .iX7Q3H6Fv4 {\n      font-size: 14px;\n      margin-top: 20px;\n      color: #555;\n      text-align: center;\n      background: linear-gradient(to top, #d3f9d8 0%, #e1f7e0 60%, #f5fdf5 100%);\n      padding: 20px;\n    }\n\n    .yl-reviews-section .iX7Q3H6Fv4 span {\n      background-color: #28a745;\n      color: white;\n      padding: 2px 8px;\n      border-radius: 4px;\n    }\n\n    .yl-reviews-section .F0rW6K8yEz::-webkit-scrollbar {\n      height: 8px;\n    }\n\n    .yl-reviews-section .F0rW6K8yEz::-webkit-scrollbar-thumb {\n      background-color: #28a745;\n      border-radius: 10px;\n    }\n\n    .yl-reviews-section .F0rW6K8yEz::-webkit-scrollbar-track {\n      background-color: #f5fdf5;\n    }\n\n    @media screen and (max-width: 749px) {\n      .yl-reviews-section h1.d3FsH6IqT4 {\n        font-size: 23px;\n      }\n\n      .yl-reviews-section .F0rW6K8yEz {\n        width: 100%;\n        padding: 16px;\n        gap: 14px;\n      }\n\n      .yl-reviews-section .nQ0V3S1vD7 {\n        width: 82%;\n        min-width: 82%;\n        padding: 18px;\n      }\n    }\n  </style>\n\n  <h1 class=\"d3FsH6IqT4\">Tu <span class=\"AaB2Y5Gp9f\">bienestar</span> es nuestro éxito</h1>\n  <p class=\"RwV2N5Lt0I\">Clientes que ya integraron Liquid NAD+ a su rutina diaria</p>\n\n  <div class=\"LaVtZ1Q0xK\">\n    <div class=\"KsF9M8H2Ej\">\n      <img src=\"https://i.imgur.com/EHjNmTM.png\" alt=\"5 estrellas\">\n    </div>\n    <div class=\"jX4N5P7Dr6\">\n      Puntuación <span class=\"Yk4V8N6Vf1\">4.9 | 14,500+</span> reseñas\n    </div>\n  </div>\n\n  <div class=\"F0rW6K8yEz\">\n\n    <div class=\"nQ0V3S1vD7\">\n      <div class=\"Fb0W9T8TjZ\">Mariana G.</div>\n      <div class=\"rT9B3G2MdF\">Hace unos minutos</div>\n      <div class=\"gP9Z3A2Kn7\">\"Llevo casi 3 semanas tomándolo y lo que más noté fue la energía más estable durante el día. Antes me daba un bajón fuerte en la tarde, pero ahora llego mejor al final del día. El sabor es ligero y se toma fácil.\"</div>\n      <div class=\"Vh3J2R4Nw1\">✔ Reseña de cliente</div>\n      <div class=\"Bz5W3F7Wz2\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M12 .587l3.668 7.431L24 9.748l-6 5.832 1.42 8.271L12 18.896l-7.42 4.955L6 15.58l-6-5.832 8.332-1.73z\"/></svg>\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M12 .587l3.668 7.431L24 9.748l-6 5.832 1.42 8.271L12 18.896l-7.42 4.955L6 15.58l-6-5.832 8.332-1.73z\"/></svg>\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M12 .587l3.668 7.431L24 9.748l-6 5.832 1.42 8.271L12 18.896l-7.42 4.955L6 15.58l-6-5.832 8.332-1.73z\"/></svg>\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M12 .587l3.668 7.431L24 9.748l-6 5.832 1.42 8.271L12 18.896l-7.42 4.955L6 15.58l-6-5.832 8.332-1.73z\"/></svg>\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M12 .587l3.668 7.431L24 9.748l-6 5.832 1.42 8.271L12 18.896l-7.42 4.955L6 15.58l-6-5.832 8.332-1.73z\"/></svg>\n      </div>\n    </div>\n\n    <div class=\"nQ0V3S1vD7\">\n      <div class=\"Fb0W9T8TjZ\">Claudia R.</div>\n      <div class=\"rT9B3G2MdF\">Hace 2 horas</div>\n      <div class=\"gP9Z3A2Kn7\">\"No esperaba notar nada en la piel, pero después de varios días sentí la cara menos apagada y con mejor aspecto. Me gusta porque no son cápsulas enormes, es práctico y fácil de incluir en la rutina.\"</div>\n      <div class=\"Vh3J2R4Nw1\">✔ Reseña de cliente</div>\n      <div class=\"Bz5W3F7Wz2\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M12 .587l3.668 7.431L24 9.748l-6 5.832 1.42 8.271L12 18.896l-7.42 4.955L6 15.58l-6-5.832 8.332-1.73z\"/></svg>\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M12 .587l3.668 7.431L24 9.748l-6 5.832 1.42 8.271L12 18.896l-7.42 4.955L6 15.58l-6-5.832 8.332-1.73z\"/></svg>\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M12 .587l3.668 7.431L24 9.748l-6 5.832 1.42 8.271L12 18.896l-7.42 4.955L6 15.58l-6-5.832 8.332-1.73z\"/></svg>\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M12 .587l3.668 7.431L24 9.748l-6 5.832 1.42 8.271L12 18.896l-7.42 4.955L6 15.58l-6-5.832 8.332-1.73z\"/></svg>\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M12 .587l3.668 7.431L24 9.748l-6 5.832 1.42 8.271L12 18.896l-7.42 4.955L6 15.58l-6-5.832 8.332-1.73z\"/></svg>\n      </div>\n    </div>\n\n    <div class=\"nQ0V3S1vD7\">\n      <div class=\"Fb0W9T8TjZ\">Daniel M.</div>\n      <div class=\"rT9B3G2MdF\">Hace 1 día</div>\n      <div class=\"gP9Z3A2Kn7\">\"Trabajo muchas horas frente a la computadora y últimamente me sentía sin pila. Con este NAD+ líquido he sentido más claridad y menos cansancio mental. No es magia, pero sí se nota cuando lo tomas constante.\"</div>\n      <div class=\"Vh3J2R4Nw1\">✔ Reseña de cliente</div>\n      <div class=\"Bz5W3F7Wz2\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M12 .587l3.668 7.431L24 9.748l-6 5.832 1.42 8.271L12 18.896l-7.42 4.955L6 15.58l-6-5.832 8.332-1.73z\"/></svg>\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M12 .587l3.668 7.431L24 9.748l-6 5.832 1.42 8.271L12 18.896l-7.42 4.955L6 15.58l-6-5.832 8.332-1.73z\"/></svg>\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M12 .587l3.668 7.431L24 9.748l-6 5.832 1.42 8.271L12 18.896l-7.42 4.955L6 15.58l-6-5.832 8.332-1.73z\"/></svg>\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M12 .587l3.668 7.431L24 9.748l-6 5.832 1.42 8.271L12 18.896l-7.42 4.955L6 15.58l-6-5.832 8.332-1.73z\"/></svg>\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M12 .587l3.668 7.431L24 9.748l-6 5.832 1.42 8.271L12 18.896l-7.42 4.955L6 15.58l-6-5.832 8.332-1.73z\"/></svg>\n      </div>\n    </div>\n\n    <div class=\"nQ0V3S1vD7\">\n      <div class=\"Fb0W9T8TjZ\">Patricia L.</div>\n      <div class=\"rT9B3G2MdF\">Hace 3 días</div>\n      <div class=\"gP9Z3A2Kn7\">\"He probado suplementos en cápsulas y siempre los dejo. Este me gustó porque es líquido, sabe bien y no me cae pesado. Lo tomo por las mañanas y siento que empiezo el día con más energía.\"</div>\n      <div class=\"Vh3J2R4Nw1\">✔ Reseña de cliente</div>\n      <div class=\"Bz5W3F7Wz2\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M12 .587l3.668 7.431L24 9.748l-6 5.832 1.42 8.271L12 18.896l-7.42 4.955L6 15.58l-6-5.832 8.332-1.73z\"/></svg>\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M12 .587l3.668 7.431L24 9.748l-6 5.832 1.42 8.271L12 18.896l-7.42 4.955L6 15.58l-6-5.832 8.332-1.73z\"/></svg>\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M12 .587l3.668 7.431L24 9.748l-6 5.832 1.42 8.271L12 18.896l-7.42 4.955L6 15.58l-6-5.832 8.332-1.73z\"/></svg>\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M12 .587l3.668 7.431L24 9.748l-6 5.832 1.42 8.271L12 18.896l-7.42 4.955L6 15.58l-6-5.832 8.332-1.73z\"/></svg>\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M12 .587l3.668 7.431L24 9.748l-6 5.832 1.42 8.271L12 18.896l-7.42 4.955L6 15.58l-6-5.832 8.332-1.73z\"/></svg>\n      </div>\n    </div>\n\n    <div class=\"nQ0V3S1vD7\">\n      <div class=\"Fb0W9T8TjZ\">Alejandra S.</div>\n      <div class=\"rT9B3G2MdF\">Hace 5 días</div>\n      <div class=\"gP9Z3A2Kn7\">\"Me gustó mucho. La presentación se siente premium, el sabor no es fuerte y después de dos semanas empecé a notar más energía y mejor ánimo. Ya pedí otro para no quedarme sin.\"</div>\n      <div class=\"Vh3J2R4Nw1\">✔ Reseña de cliente</div>\n      <div class=\"Bz5W3F7Wz2\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M12 .587l3.668 7.431L24 9.748l-6 5.832 1.42 8.271L12 18.896l-7.42 4.955L6 15.58l-6-5.832 8.332-1.73z\"/></svg>\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M12 .587l3.668 7.431L24 9.748l-6 5.832 1.42 8.271L12 18.896l-7.42 4.955L6 15.58l-6-5.832 8.332-1.73z\"/></svg>\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M12 .587l3.668 7.431L24 9.748l-6 5.832 1.42 8.271L12 18.896l-7.42 4.955L6 15.58l-6-5.832 8.332-1.73z\"/></svg>\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M12 .587l3.668 7.431L24 9.748l-6 5.832 1.42 8.271L12 18.896l-7.42 4.955L6 15.58l-6-5.832 8.332-1.73z\"/></svg>\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M12 .587l3.668 7.431L24 9.748l-6 5.832 1.42 8.271L12 18.896l-7.42 4.955L6 15.58l-6-5.832 8.332-1.73z\"/></svg>\n      </div>\n    </div>\n\n    <div class=\"nQ0V3S1vD7\">\n      <div class=\"Fb0W9T8TjZ\">Fernanda A.</div>\n      <div class=\"rT9B3G2MdF\">Hace 1 semana</div>\n      <div class=\"gP9Z3A2Kn7\">\"Lo tomo cada mañana antes de empezar el día. Me gusta porque no me da nervios como el café, solo siento energía más limpia y constante. También he notado mi piel un poco más luminosa.\"</div>\n      <div class=\"Vh3J2R4Nw1\">✔ Reseña de cliente</div>\n      <div class=\"Bz5W3F7Wz2\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M12 .587l3.668 7.431L24 9.748l-6 5.832 1.42 8.271L12 18.896l-7.42 4.955L6 15.58l-6-5.832 8.332-1.73z\"/></svg>\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M12 .587l3.668 7.431L24 9.748l-6 5.832 1.42 8.271L12 18.896l-7.42 4.955L6 15.58l-6-5.832 8.332-1.73z\"/></svg>\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M12 .587l3.668 7.431L24 9.748l-6 5.832 1.42 8.271L12 18.896l-7.42 4.955L6 15.58l-6-5.832 8.332-1.73z\"/></svg>\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M12 .587l3.668 7.431L24 9.748l-6 5.832 1.42 8.271L12 18.896l-7.42 4.955L6 15.58l-6-5.832 8.332-1.73z\"/></svg>\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M12 .587l3.668 7.431L24 9.748l-6 5.832 1.42 8.271L12 18.896l-7.42 4.955L6 15.58l-6-5.832 8.332-1.73z\"/></svg>\n      </div>\n    </div>\n\n    <div class=\"nQ0V3S1vD7\">\n      <div class=\"Fb0W9T8TjZ\">Lucía P.</div>\n      <div class=\"rT9B3G2MdF\">Hace 1 semana</div>\n      <div class=\"gP9Z3A2Kn7\">\"Soy pésima para tomar cápsulas, por eso me animé con este formato. Se toma rápido, no deja mal sabor y me ha ayudado a sentirme más activa. Me parece muy cómodo.\"</div>\n      <div class=\"Vh3J2R4Nw1\">✔ Reseña de cliente</div>\n      <div class=\"Bz5W3F7Wz2\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M12 .587l3.668 7.431L24 9.748l-6 5.832 1.42 8.271L12 18.896l-7.42 4.955L6 15.58l-6-5.832 8.332-1.73z\"/></svg>\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M12 .587l3.668 7.431L24 9.748l-6 5.832 1.42 8.271L12 18.896l-7.42 4.955L6 15.58l-6-5.832 8.332-1.73z\"/></svg>\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M12 .587l3.668 7.431L24 9.748l-6 5.832 1.42 8.271L12 18.896l-7.42 4.955L6 15.58l-6-5.832 8.332-1.73z\"/></svg>\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M12 .587l3.668 7.431L24 9.748l-6 5.832 1.42 8.271L12 18.896l-7.42 4.955L6 15.58l-6-5.832 8.332-1.73z\"/></svg>\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M12 .587l3.668 7.431L24 9.748l-6 5.832 1.42 8.271L12 18.896l-7.42 4.955L6 15.58l-6-5.832 8.332-1.73z\"/></svg>\n      </div>\n    </div>\n\n    <div class=\"nQ0V3S1vD7\">\n      <div class=\"Fb0W9T8TjZ\">Gabriela T.</div>\n      <div class=\"rT9B3G2MdF\">Hace 2 semanas</div>\n      <div class=\"gP9Z3A2Kn7\">\"Antes a las 4 o 5 pm ya estaba agotada. Desde que lo tomo, siento que mi energía dura más. También me veo menos cansada en el espejo, que para mí ya es bastante.\"</div>\n      <div class=\"Vh3J2R4Nw1\">✔ Reseña de cliente</div>\n      <div class=\"Bz5W3F7Wz2\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M12 .587l3.668 7.431L24 9.748l-6 5.832 1.42 8.271L12 18.896l-7.42 4.955L6 15.58l-6-5.832 8.332-1.73z\"/></svg>\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M12 .587l3.668 7.431L24 9.748l-6 5.832 1.42 8.271L12 18.896l-7.42 4.955L6 15.58l-6-5.832 8.332-1.73z\"/></svg>\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M12 .587l3.668 7.431L24 9.748l-6 5.832 1.42 8.271L12 18.896l-7.42 4.955L6 15.58l-6-5.832 8.332-1.73z\"/></svg>\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M12 .587l3.668 7.431L24 9.748l-6 5.832 1.42 8.271L12 18.896l-7.42 4.955L6 15.58l-6-5.832 8.332-1.73z\"/></svg>\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M12 .587l3.668 7.431L24 9.748l-6 5.832 1.42 8.271L12 18.896l-7.42 4.955L6 15.58l-6-5.832 8.332-1.73z\"/></svg>\n      </div>\n    </div>\n\n  </div>\n\n  <div class=\"iX7Q3H6Fv4\">Basado en <span>14,500+</span> experiencias de clientes</div>\n</section>",
