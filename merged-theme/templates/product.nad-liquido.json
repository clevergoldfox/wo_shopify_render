        "custom_liquid_JU8meJ": {
          "type": "custom_liquid",
          "name": "RESEÑAS ",
          "disabled": true,
          "settings": {
            "custom_liquid": "<div class=\"nv-block nv-block--reviews\">\n  <div class=\"nv-review-wrap\">\n    <h3 class=\"nv-review-title\">Reseñas Reales de Clientes</h3>\n    <p class=\"nv-review-sub\">Opiniones verificadas de clientes en México que ya lo integraron a su rutina diaria.</p>\n\n    <div class=\"nv-review-card\">\n      <div class=\"nv-review-top\">\n        <span class=\"nv-verified\">Cliente verificado</span>\n        <div class=\"nv-stars\" aria-label=\"5 estrellas\">★★★★★</div>\n      </div>\n\n      <div class=\"nv-review-quote\" id=\"nvQuote\">\n        “Me gustó porque no son pastillas. Lo pongo debajo de la lengua y listo. Súper práctico para el día a día.”\n      </div>\n\n      <div class=\"nv-review-person\" id=\"nvPerson\">— Fernanda M. · Guadalajara</div>\n\n      <div class=\"nv-dots\" aria-hidden=\"true\">\n        <span class=\"nv-dot nv-dot--active\"></span>\n        <span class=\"nv-dot\"></span>\n        <span class=\"nv-dot\"></span>\n        <span class=\"nv-dot\"></span>\n      </div>\n    </div>\n  </div>\n</div>\n\n<style>\n  /* ESPACIADO ENTRE LIQUIDS */\n  .nv-block--reviews{\n    margin-top: 18px;   /* separa del liquid de arriba */\n    margin-bottom: 18px;\n  }\n\n  .nv-review-wrap{ margin:0; }\n  .nv-review-title{ font-weight:800; font-size:18px; margin:0 0 4px; color:#111; }\n  .nv-review-sub{ margin:0 0 10px; font-size:12px; color:rgba(0,0,0,.55); }\n\n  .nv-review-card{\n    background:#f6efe4;\n    border:1px solid rgba(0,0,0,.08);\n    border-radius:14px;\n    padding:14px 14px 12px;\n  }\n\n  .nv-review-top{\n    display:flex; align-items:center; justify-content:space-between;\n    gap:12px; margin-bottom:10px;\n  }\n\n  .nv-verified{\n    font-style:italic;\n    font-size:12px;\n    color:rgba(0,0,0,.55);\n  }\n\n  .nv-stars{\n    color:#d7a31a;\n    font-size:13px;\n    letter-spacing:1px;\n    line-height:1;\n    white-space:nowrap;\n  }\n\n  .nv-review-quote{\n    font-size:13px;\n    line-height:1.5;\n    color:#111;\n    margin:0 0 10px;\n  }\n\n  .nv-review-person{\n    font-weight:700;\n    font-size:12px;\n    color:#111;\n    margin:0 0 10px;\n  }\n\n  .nv-dots{\n    display:flex; align-items:center; justify-content:center;\n    gap:6px; margin-top:2px;\n  }\n\n  .nv-dot{\n    width:7px; height:7px; border-radius:999px;\n    background:rgba(0,0,0,.18);\n  }\n\n  .nv-dot--active{ background:rgba(0,0,0,.55); }\n</style>\n\n<script>\n(function(){\n  const reviews = [\n    { quote:\"Me gustó porque no son pastillas. Lo pongo debajo de la lengua y listo. Súper práctico para el día a día.\", person:\"— Fernanda M. · Guadalajara\" },\n    { quote:\"Llegó rápido y bien empacado. Está fácil de usar y el sabor no es pesado. Lo agregué a mi rutina en la mañana.\", person:\"— Daniel R. · CDMX\" },\n    { quote:\"Me gustó que viene en gotero y no batallas. Se siente como un complemento práctico para días con mucho ritmo.\", person:\"— Karla S. · Monterrey\" },\n    { quote:\"Muy cómodo para quienes no queremos cápsulas grandes. Buen servicio y presentación. Lo volvería a pedir.\", person:\"— José L. · Puebla\" }\n  ];\n\n  const quoteEl = document.getElementById('nvQuote');\n  const personEl = document.getElementById('nvPerson');\n  const dots = document.querySelectorAll('.nv-dot');\n  if(!quoteEl || !personEl || dots.length < 4) return;\n\n  let i = 0;\n  function render(){\n    quoteEl.textContent = \"“\" + reviews[i].quote.trim() + \"”\";\n    personEl.textContent = reviews[i].person;\n    dots.forEach((d,idx)=>d.classList.toggle('nv-dot--active', idx===i));\n  }\n  render();\n  setInterval(()=>{ i=(i+1)%reviews.length; render(); }, 4500);\n})();\n</script>"
          }
        },
