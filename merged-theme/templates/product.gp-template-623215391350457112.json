        "ggUc-jCnTnI_text": "<p><span style=\"color:#FFFFFF;\">Toma 2 cápsulas con agua por la noche e incorpóralas a tu rutina antes de dormir.</span></p>",
        "ggXZsk341s-_text": "Descansa mejor",
        "ggYrrf0svF7_background_desktop_image_src": "https://cdn.shopify.com/s/files/1/0946/3011/7697/files/unnamed_1_4c762d0b-b79e-4fa3-ab18-79fad618df62.png",
        "ggeWSdReMFY_text": "<p><span style=\"background-color:rgba(255,255,255,0);color:rgb(255,255,255);\">Favorece una rutina nocturna más tranquila, sin depender de melatonina.</span></p>",
        "ggmFngOgeXy_text": "<p><span style=\"background-color:rgba(255,255,255,0);color:rgb(255,255,255);\">El magnesio ayuda a apoyar la función normal del sistema nervioso y la relajación muscular.</span></p>",
