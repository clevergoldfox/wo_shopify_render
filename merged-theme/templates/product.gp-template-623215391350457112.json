    "gp_section_623215391501714200": {
      "settings": {
        "checksum": "0660400370874135e76c53d7c3bb7cd5c47b1a65c56fdb454362bfecf2d2d950_1_1_1_0__1",
        "gg-cP2BjzMQ_text": "<p><span style=\"color:rgb(0,0,0);\">Si no notas una mejora en tu rutina de descanso, relajación o bienestar diario, te devolvemos el dinero.</span></p>",
        "ggKSpB0EzPD_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0946/3011/7697/files/shutterstock_2315184091-_Converted_73836ed7-ff71-4270-9475-c925becdec10.png",
        "ggKtueiFKF2_text": "<p>Usa Magnesium Complex cada noche y dale a tu cuerpo el apoyo mineral que necesita. Si después de 60 días no sientes que encaja contigo, contacta con nosotros y gestionaremos tu devolución.</p>",
        "gglybhX72sJ_text": "<span style=\"color:rgb(0,0,0);\">Pruébalo sin riesgo durante 60 días</span>",
