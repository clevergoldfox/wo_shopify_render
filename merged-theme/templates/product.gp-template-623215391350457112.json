        "ggZ4wUZMGfh_background_tablet_videoHtml5": "https://media.w3.org/2010/05/sintel/trailer.mp4",
        "gg_5lJJTvHF_text": "<p><strong>Laura M., 38 | Rutina wellness</strong></p>",
        "ggePWZcZ3xD_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0703/5214/2562/files/gempages_518090459516502570-fd204759-bd9d-4564-9e30-3ff2facb72de.png",
        "ggw9y2me8ef_text": "<p><span style=\"color:rgb(0,0,0);\">Lo compré porque entreno y a veces tenía molestias musculares. Con constancia he notado una recuperación más cómoda y menos tensión por la noche.</span></p>",
        "ggxq1Sz7P3J_text": "<p><span style=\"color:rgb(0,0,0);\">“Me ayuda con los calambres”</span></p>",
        "ggzAFaK0ixu_text": "<p><span style=\"color:rgb(0,0,0);\">Empecé a tomarlo por la noche porque me costaba desconectar. No es algo que me deje atontada, simplemente noto que llego a la cama más relajada y descanso mejor.</span></p>",
