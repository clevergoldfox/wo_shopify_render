        "ggEh2fZHJ4d_text": "Relaja cuerpo y mente",
        "ggFzGJS88XV_text": "<p><span style=\"background-color:rgba(255,255,255,0);color:rgb(255,255,255);\">Un mejor descanso puede ayudarte a empezar el día con una sensación más renovada y equilibrada.</span></p>",
        "ggNkdjnIp1U_text": "<span style=\"color:#FFFFFF;\">Tu camino hacia un descanso más reparador</span>",
