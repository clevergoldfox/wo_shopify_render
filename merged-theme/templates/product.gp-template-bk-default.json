    "custom_liquid_jpUQx3": {
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "color_scheme": "background-1",
        "custom_liquid": "<section class=\"mx-testis\">\n  <div class=\"mx-testis__head\">\n    <h2 class=\"mx-testis__title\">Testimonios</h2>\n    <p class=\"mx-testis__sub\">Reseñas verificadas de clientes en México</p>\n  </div>\n\n  <div class=\"mx-testis__card\" role=\"region\" aria-label=\"Carrusel de testimonios\">\n    <div class=\"mx-testis__quoteIcon\" aria-hidden=\"true\">“</div>\n\n    <div class=\"mx-testis__stars\" aria-label=\"5 estrellas\">★★★★★</div>\n\n    <h3 class=\"mx-testis__h\" id=\"mxTTitle\">Me ayudó con el enfoque</h3>\n    <p class=\"mx-testis__p\" id=\"mxTText\">\n      “No sé explicarlo, pero ando más ‘presente’. Menos niebla mental y más fácil sentarme a trabajar sin distraerme tanto.”\n    </p>\n    <div class=\"mx-testis__by\" id=\"mxTBy\">— Fernanda M. · Monterrey</div>\n\n    <div class=\"mx-testis__dots\" role=\"tablist\" aria-label=\"Navegación testimonios\">\n      <button class=\"mx-dot is-active\" aria-label=\"Testimonio 1\"></button>\n      <button class=\"mx-dot\" aria-label=\"Testimonio 2\"></button>\n      <button class=\"mx-dot\" aria-label=\"Testimonio 3\"></button>\n      <button class=\"mx-dot\" aria-label=\"Testimonio 4\"></button>\n    </div>\n  </div>\n</section>\n\n<style>\n  .mx-testis{ margin: 22px 0 26px; }\n  .mx-testis__head{ text-align:center; margin-bottom: 10px; }\n  .mx-testis__title{\n    margin:0;\n    font-size: 34px;\n    line-height:1.05;\n    font-weight: 900;\n    color:#111;\n  }\n  .mx-testis__sub{\n    margin:6px 0 0;\n    font-size: 13px;\n    color: rgba(0,0,0,.55);\n  }\n\n  .mx-testis__card{\n    position:relative;\n    border-radius: 18px;\n    border: 1px solid rgba(0,0,0,.10);\n    background: linear-gradient(180deg, #f7f3ee 0%, #ead9bf 100%);\n    box-shadow: 0 16px 34px rgba(0,0,0,.08);\n    padding: 26px 18px 18px;\n    max-width: 980px;\n    margin: 14px auto 0;\n    text-align:center;\n  }\n\n  .mx-testis__quoteIcon{\n    position:absolute;\n    top:14px;\n    right:14px;\n    width:34px;\n    height:34px;\n    border-radius:999px;\n    display:flex;\n    align-items:center;\n    justify-content:center;\n    background: rgba(255,255,255,.65);\n    border: 1px solid rgba(0,0,0,.10);\n    color:#111;\n    font-weight: 900;\n    font-size: 18px;\n    line-height: 1;\n  }\n\n  .mx-testis__stars{\n    color: #c99a2e;\n    letter-spacing: 2px;\n    font-size: 16px;\n    margin-bottom: 10px;\n  }\n\n  .mx-testis__h{\n    margin: 0 0 8px;\n    font-size: 22px;\n    font-weight: 900;\n    color:#111;\n  }\n\n  .mx-testis__p{\n    margin: 0 auto 10px;\n    max-width: 820px;\n    font-size: 14px;\n    line-height: 1.6;\n    color: rgba(0,0,0,.70);\n  }\n\n  .mx-testis__by{\n    font-weight: 800;\n    font-size: 13px;\n    color: rgba(0,0,0,.70);\n    margin-bottom: 8px;\n  }\n\n  .mx-testis__dots{\n    display:flex;\n    gap:6px;\n    justify-content:center;\n    margin-top: 10px;\n  }\n  .mx-dot{\n    width:8px;\n    height:8px;\n    border-radius:999px;\n    border:none;\n    background: rgba(0,0,0,.20);\n    cursor:pointer;\n    padding:0;\n  }\n  .mx-dot.is-active{ background: rgba(0,0,0,.55); }\n\n  @media (max-width: 520px){\n    .mx-testis__title{ font-size: 28px; }\n    .mx-testis__h{ font-size: 20px; }\n    .mx-testis__card{ padding: 22px 14px 16px; }\n  }\n</style>\n\n<script>\n(function(){\n  const data = [\n    {\n      title: \"Me ayudó con el enfoque\",\n      text: \"“No sé explicarlo, pero ando más ‘presente’. Menos niebla mental y más fácil sentarme a trabajar sin distraerme tanto.”\",\n      by: \"— Fernanda M. · Monterrey\"\n    },\n    {\n      title: \"Energía sin picos raros\",\n      text: \"“Antes a media tarde me apagaba. Con las gotitas lo siento más parejo: me rinde el día y no termino hecha polvo.”\",\n      by: \"— Karla G. · Guadalajara\"\n    },\n    {\n      title: \"Cero pastillas, súper práctico\",\n      text: \"“Lo sublingual fue clave. Me lo pongo, espero unos segundos y listo. Me gustó porque no me cae pesado.”\",\n      by: \"— Diana R. · CDMX\"\n    },\n    {\n      title: \"Me ayudó a retomar rutina\",\n      text: \"“Entre trabajo y casa me estaba costando arrancar. Lo uso diario y me siento más constante y con mejor ánimo.”\",\n      by: \"— Paola S. · Puebla\"\n    }\n  ];\n\n  const titleEl = document.getElementById(\"mxTTitle\");\n  const textEl  = document.getElementById(\"mxTText\");\n  const byEl    = document.getElementById(\"mxTBy\");\n  const dots    = Array.from(document.querySelectorAll(\".mx-testis .mx-dot\"));\n\n  if(!titleEl || !textEl || !byEl || dots.length === 0) return;\n\n  let i = 0;\n  function render(idx){\n    i = idx;\n    titleEl.textContent = data[i].title;\n    textEl.textContent  = data[i].text;\n    byEl.textContent    = data[i].by;\n    dots.forEach((d, n)=> d.classList.toggle(\"is-active\", n===i));\n  }\n\n  dots.forEach((d, idx)=> d.addEventListener(\"click\", ()=>render(idx)));\n\n  // Autoplay suave\n  setInterval(()=> render((i+1) % data.length), 5200);\n\n  render(0);\n})();\n</script>",
