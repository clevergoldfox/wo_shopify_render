    "custom_liquid_d6j799": {
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "color_scheme": "background-1",
        "custom_liquid": "<div class=\"nvr-reset14\">\n  <div class=\"nvr-reset14__hero\">\n    <h2 class=\"nvr-reset14__h\">\n      Tu reset de 14 días,<br>\n      sin complicarte\n    </h2>\n\n    <p class=\"nvr-reset14__p\">\n      Un ciclo corto diseñado para apoyarte con <strong>más energía diaria</strong> y\n      <strong>mejor enfoque</strong>, ayudándote a sentirte más despierta y en control\n      de tu día.\n    </p>\n\n    <div class=\"nvr-reset14__pill\" role=\"note\" aria-label=\"Aviso de stock\">\n      <span class=\"nvr-reset14__pillIco\" aria-hidden=\"true\">⏳</span>\n      <span><strong>Stock limitado</strong> — alta demanda esta semana</span>\n    </div>\n  </div>\n\n  <div class=\"nvr-reset14__list\" role=\"list\">\n    <div class=\"nvr-reset14__item\" role=\"listitem\">\n      <div class=\"nvr-reset14__ico\" aria-hidden=\"true\">⚡</div>\n      <div class=\"nvr-reset14__txt\">\n        <div class=\"nvr-reset14__t\">Energía más constante</div>\n        <div class=\"nvr-reset14__d\">\n          Las vitaminas del complejo B contribuyen al metabolismo energético para apoyar una sensación\n          de vitalidad durante el día.\n        </div>\n      </div>\n    </div>\n\n    <div class=\"nvr-reset14__item\" role=\"listitem\">\n      <div class=\"nvr-reset14__ico\" aria-hidden=\"true\">🧠</div>\n      <div class=\"nvr-reset14__txt\">\n        <div class=\"nvr-reset14__t\">Enfoque y claridad</div>\n        <div class=\"nvr-reset14__d\">\n          Un aporte adecuado de vitaminas B apoya funciones clave del día a día, ayudándote a sentirte\n          más concentrada y presente.\n        </div>\n      </div>\n    </div>\n\n    <div class=\"nvr-reset14__item\" role=\"listitem\">\n      <div class=\"nvr-reset14__ico\" aria-hidden=\"true\">🛡️</div>\n      <div class=\"nvr-reset14__txt\">\n        <div class=\"nvr-reset14__t\">Soporte al sistema nervioso</div>\n        <div class=\"nvr-reset14__d\">\n          B1, B6 y B12 ayudan a apoyar la función normal del sistema nervioso, especialmente en etapas\n          de alta demanda.\n        </div>\n      </div>\n    </div>\n\n    <div class=\"nvr-reset14__item\" role=\"listitem\">\n      <div class=\"nvr-reset14__ico\" aria-hidden=\"true\">✅</div>\n      <div class=\"nvr-reset14__txt\">\n        <div class=\"nvr-reset14__t\">Rutina simple</div>\n        <div class=\"nvr-reset14__d\">\n          Solo 1.5 mL al día en formato sublingual para mantener constancia sin complicarte (sin pastillas grandes).\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"nvr-reset14__note\">\n    *Suplemento alimenticio. No está destinado a diagnosticar, tratar, curar ni prevenir ninguna enfermedad. Los resultados pueden variar según cada persona.\n  </div>\n</div>\n\n<style>\n  .nvr-reset14{\n    max-width: 1100px;\n    margin: 0 auto;\n    padding: 14px 10px 6px;\n  }\n\n  /* HERO BEIGE */\n  .nvr-reset14__hero{\n    background: #fbf6f1;\n    border: 1px solid rgba(0,0,0,.06);\n    border-radius: 18px;\n    padding: 22px 18px 18px;\n    text-align: center;\n  }\n\n  .nvr-reset14__h{\n    margin: 0;\n    font-weight: 800;\n    font-size: 26px;\n    line-height: 1.15;\n    letter-spacing: -0.02em;\n    color: #111;\n  }\n\n  .nvr-reset14__p{\n    margin: 10px auto 0;\n    max-width: 680px;\n    font-size: 13.5px;\n    line-height: 1.45;\n    color: rgba(0,0,0,.72);\n  }\n  .nvr-reset14__p strong{ color:#111; font-weight: 800; }\n\n  .nvr-reset14__pill{\n    margin: 14px auto 0;\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    padding: 10px 18px;\n    border-radius: 999px;\n    background: #f2e7dd;\n    border: 1px solid rgba(0,0,0,.08);\n    font-size: 13px;\n    color: #111;\n    line-height: 1;\n    box-shadow: 0 2px 0 rgba(0,0,0,.02);\n  }\n  .nvr-reset14__pillIco{ font-size: 14px; }\n\n  /* LIST CARDS */\n  .nvr-reset14__list{\n    margin-top: 14px;\n    display: grid;\n    gap: 10px;\n  }\n\n  .nvr-reset14__item{\n    display: flex;\n    gap: 12px;\n    align-items: flex-start;\n    background: #fff;\n    border: 1px solid rgba(0,0,0,.06);\n    border-radius: 14px;\n    padding: 14px 16px;\n    box-shadow: 0 8px 24px rgba(0,0,0,.06);\n  }\n\n  .nvr-reset14__ico{\n    width: 34px;\n    height: 34px;\n    min-width: 34px;\n    border-radius: 10px;\n    display: grid;\n    place-items: center;\n    background: rgba(0,0,0,.04);\n    font-size: 16px;\n  }\n\n  .nvr-reset14__t{\n    font-weight: 800;\n    font-size: 15px;\n    line-height: 1.2;\n    color: #111;\n    margin-top: 1px;\n  }\n\n  .nvr-reset14__d{\n    margin-top: 6px;\n    font-size: 12.5px;\n    line-height: 1.35;\n    color: rgba(0,0,0,.65);\n  }\n\n  .nvr-reset14__note{\n    margin-top: 10px;\n    font-size: 11.5px;\n    line-height: 1.35;\n    color: rgba(0,0,0,.55);\n  }\n\n  @media (max-width: 520px){\n    .nvr-reset14__h{ font-size: 22px; }\n    .nvr-reset14__p{ font-size: 13px; }\n    .nvr-reset14__item{ padding: 13px 14px; }\n  }\n</style>",
