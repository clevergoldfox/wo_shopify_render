    "custom_liquid_Yz4tNn": {
      "name": "Beneficios descripcion",
      "settings": {
        "color_scheme": "background-1",
        "custom_liquid": "<div class=\"nv-benefits\">\n  <div class=\"nv-benefit\">\n    <div class=\"nv-benefit__icon\">✓</div>\n    <div class=\"nv-benefit__text\">\n      <div class=\"nv-benefit__title\">Más energía durante el día</div>\n      <div class=\"nv-benefit__desc\">Las vitaminas del complejo B apoyan el metabolismo energético para que te sientas con mejor ritmo en tu rutina diaria.*</div>\n    </div>\n  </div>\n\n  <div class=\"nv-benefit\">\n    <div class=\"nv-benefit__icon\">✓</div>\n    <div class=\"nv-benefit__text\">\n      <div class=\"nv-benefit__title\">Sistema nervioso en equilibrio</div>\n      <div class=\"nv-benefit__desc\">B1, B6 y B12 contribuyen al funcionamiento normal del sistema nervioso, ideal para días intensos y con mucho movimiento.*</div>\n    </div>\n  </div>\n\n  <div class=\"nv-benefit\">\n    <div class=\"nv-benefit__icon\">✓</div>\n    <div class=\"nv-benefit__text\">\n      <div class=\"nv-benefit__title\">Enfoque y claridad mental</div>\n      <div class=\"nv-benefit__desc\">Un buen aporte de vitaminas B ayuda a mantener la concentración y el rendimiento mental en tus tareas de todos los días.*</div>\n    </div>\n  </div>\n\n  <div class=\"nv-benefit\">\n    <div class=\"nv-benefit__icon\">✓</div>\n    <div class=\"nv-benefit__text\">\n      <div class=\"nv-benefit__title\">Sublingual y fácil de seguir</div>\n      <div class=\"nv-benefit__desc\">Gotas sublinguales: rápido, práctico y sin batallar con pastillas. Se integra en segundos a tu mañana.</div>\n    </div>\n  </div>\n\n  <div class=\"nv-benefits__foot\">\n    *Complemento alimenticio. No sustituye una alimentación equilibrada. Resultados pueden variar.\n  </div>\n</div>\n\n<style>\n  .nv-benefits{\n    display:grid;\n    gap:14px;\n    margin: 18px 0;\n  }\n\n  .nv-benefit{\n    background:#f6efe4;\n    border:1px solid rgba(0,0,0,.08);\n    border-radius:16px;\n    padding:14px 16px;\n    display:flex;\n    gap:12px;\n    align-items:flex-start;\n  }\n\n  .nv-benefit__icon{\n    width:26px;\n    height:26px;\n    border-radius:999px;\n    display:flex;\n    align-items:center;\n    justify-content:center;\n    background:#d7c09a;\n    color:#fff;\n    font-weight:900;\n    font-size:14px;\n    line-height:1;\n    flex:0 0 auto;\n    margin-top:1px;\n  }\n\n  .nv-benefit__title{\n    font-weight:800;\n    font-size:14px;\n    line-height:1.2;\n    color:#111;\n    margin:0;\n  }\n\n  .nv-benefit__desc{\n    margin-top:4px;\n    font-size:12.5px;\n    line-height:1.45;\n    color:rgba(0,0,0,.68);\n  }\n\n  .nv-benefits__foot{\n    font-size:10.5px;\n    line-height:1.25;\n    color:rgba(0,0,0,.55);\n    margin-top:2px;\n  }\n\n  @media(max-width:520px){\n    .nv-benefit{ padding:13px 14px; border-radius:14px; }\n    .nv-benefit__title{ font-size:14px; }\n    .nv-benefit__desc{ font-size:12.25px; }\n  }\n</style>",
