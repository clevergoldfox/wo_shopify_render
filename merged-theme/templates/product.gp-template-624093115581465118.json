        "ggLaYbsbv1h_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0703/5214/2562/files/gempages_518090459516502570-fd204759-bd9d-4564-9e30-3ff2facb72de.png",
        "ggNWeWRXM1x_text": "<p>“Menos rigidez y mejor aspecto general”</p>",
        "ggPHPfaU3Cn_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0703/5214/2562/files/gempages_518090459516502570-fd204759-bd9d-4564-9e30-3ff2facb72de.png",
        "ggT52sE1x99_text": "<p><strong>Carmen R., 47 | Vida activa</strong></p>",
        "ggUoswQAKH1_text": "<p><span style=\"color:rgb(0,0,0);\">“Mi piel se ve más firme y luminosa”</span></p>",
        "ggZ4wUZMGfh_background_desktop_video": "https://www.youtube.com/watch?v=cyzh48XRS4M",
        "ggZ4wUZMGfh_background_desktop_videoHtml5": "https://media.w3.org/2010/05/sintel/trailer.mp4",
