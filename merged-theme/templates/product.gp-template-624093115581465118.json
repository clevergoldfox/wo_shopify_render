        "ggZ4wUZMGfh_background_tablet_videoHtml5": "https://media.w3.org/2010/05/sintel/trailer.mp4",
        "gg_5lJJTvHF_text": "<p><strong>Laura M., 38 | Rutina wellness</strong></p>",
        "ggePWZcZ3xD_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0703/5214/2562/files/gempages_518090459516502570-fd204759-bd9d-4564-9e30-3ff2facb72de.png",
        "ggw9y2me8ef_text": "<p><span style=\"color:rgb(0,0,0);\">Lo compré por la piel, pero me convenció que también apoye </span><strong>cabello, uñas y articulaciones</strong><span style=\"color:rgb(0,0,0);\">. Es cómodo, fácil de tomar y ya forma parte de mi rutina diaria.</span></p>",
        "ggxq1Sz7P3J_text": "<p>“Me encanta porque es muy completo”</p>",
        "ggzAFaK0ixu_text": "<p><span style=\"color:rgb(0,0,0);\">Lo empecé a tomar porque notaba la piel <strong>más apagada y con menos firmeza</strong>. Después de varias semanas de uso constante, siento la piel <strong>más cuidada, más suave y con mejor aspecto</strong>.</span></p>"
      },
