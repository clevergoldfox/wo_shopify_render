        "ggUc-jCnTnI_text": "<p><span style=\"background-color:rgba(255,255,255,0);color:rgb(255,255,255);\">Incorpora las cápsulas a tu rutina con agua, preferiblemente <strong>junto a una comida</strong>.</span></p>",
        "ggXZsk341s-_text": "Sé constante",
