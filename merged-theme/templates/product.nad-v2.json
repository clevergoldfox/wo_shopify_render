    "custom_liquid_db4P3A": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "display_id": false,
        "visibility": "always-display",
        "custom_liquid": "<section class=\"nuvira-problem-section\">\n  <div class=\"nuvira-problem-container\">\n\n    <div class=\"nuvira-problem-header\">\n      <h2>NO ES SOLO CANSANCIO.</h2>\n      <h3>ES ENERGÍA CELULAR.</h3>\n      <p>\n        Si últimamente notas menos energía, falta de concentración o una vitalidad más baja, puede que tu cuerpo necesite apoyo desde dentro.\n      </p>\n    </div>\n\n    <div class=\"nuvira-problem-list\">\n\n      <div class=\"nuvira-problem-item\">\n        <span class=\"nuvira-check-icon\">✓</span>\n        <p><strong>Te cuesta mantener la energía durante todo el día</strong></p>\n      </div>\n\n      <div class=\"nuvira-problem-item\">\n        <span class=\"nuvira-check-icon\">✓</span>\n        <p><strong>Notas niebla mental o falta de concentración</strong></p>\n      </div>\n\n      <div class=\"nuvira-problem-item\">\n        <span class=\"nuvira-check-icon\">✓</span>\n        <p><strong>Sientes que tu piel y vitalidad no son las de antes</strong></p>\n      </div>\n\n      <div class=\"nuvira-problem-item\">\n        <span class=\"nuvira-check-icon\">✓</span>\n        <p><strong>Buscas una rutina simple, no 4 suplementos distintos</strong></p>\n      </div>\n\n      <div class=\"nuvira-problem-item\">\n        <span class=\"nuvira-check-icon\">✓</span>\n        <p><strong>Quieres cuidar tu bienestar desde dentro</strong></p>\n      </div>\n\n    </div>\n\n  </div>\n</section>\n\n<style>\n  .nuvira-problem-section {\n    width: 100%;\n    background: #ffffff;\n    padding: 70px 20px;\n    box-sizing: border-box;\n    font-family: inherit;\n  }\n\n  .nuvira-problem-container {\n    max-width: 1180px;\n    margin: 0 auto;\n    text-align: center;\n  }\n\n  .nuvira-problem-header h2 {\n    margin: 0 0 18px 0;\n    color: #111111;\n    font-size: 32px;\n    line-height: 1.15;\n    font-weight: 900;\n    letter-spacing: 2px;\n    text-transform: uppercase;\n  }\n\n  .nuvira-problem-header h3 {\n    margin: 0 0 18px 0;\n    color: #D7C09A;\n    font-size: 32px;\n    line-height: 1.15;\n    font-weight: 900;\n    letter-spacing: 2px;\n    text-transform: uppercase;\n  }\n\n  .nuvira-problem-header p {\n    max-width: 850px;\n    margin: 0 auto 34px auto;\n    color: #1a1a1a;\n    font-size: 16px;\n    line-height: 1.6;\n    letter-spacing: 0.6px;\n  }\n\n  .nuvira-problem-list {\n    max-width: 850px;\n    margin: 0 auto;\n    text-align: left;\n  }\n\n  .nuvira-problem-item {\n    display: flex;\n    align-items: flex-start;\n    gap: 12px;\n    margin-bottom: 18px;\n  }\n\n  .nuvira-check-icon {\n    width: 20px;\n    height: 20px;\n    min-width: 20px;\n    border-radius: 50%;\n    background: #D7C09A;\n    color: #ffffff;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 13px;\n    font-weight: 900;\n    line-height: 1;\n    margin-top: 2px;\n  }\n\n  .nuvira-problem-item p {\n    margin: 0;\n    color: #1a1a1a;\n    font-size: 17px;\n    line-height: 1.45;\n    letter-spacing: 0.7px;\n  }\n\n  .nuvira-problem-item strong {\n    font-weight: 900;\n  }\n\n  @media (max-width: 768px) {\n    .nuvira-problem-section {\n      padding: 54px 16px;\n    }\n\n    .nuvira-problem-header h2,\n    .nuvira-problem-header h3 {\n      font-size: 26px;\n      letter-spacing: 1.2px;\n    }\n\n    .nuvira-problem-header p {\n      font-size: 15px;\n      line-height: 1.5;\n      margin-bottom: 28px;\n    }\n\n    .nuvira-problem-list {\n      max-width: 100%;\n    }\n\n    .nuvira-problem-item {\n      margin-bottom: 16px;\n      gap: 10px;\n    }\n\n    .nuvira-problem-item p {\n      font-size: 15px;\n      letter-spacing: 0.3px;\n    }\n  }\n\n  @media (max-width: 480px) {\n    .nuvira-problem-section {\n      padding: 46px 14px;\n    }\n\n    .nuvira-problem-header h2,\n    .nuvira-problem-header h3 {\n      font-size: 23px;\n    }\n\n    .nuvira-check-icon {\n      width: 19px;\n      height: 19px;\n      min-width: 19px;\n      font-size: 12px;\n    }\n  }\n</style>",
