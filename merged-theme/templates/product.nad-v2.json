    "custom_liquid_8aET4z": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "display_id": false,
        "visibility": "always-display",
        "custom_liquid": "<section class=\"nuvira-results-section\">\n  <div class=\"nuvira-results-container\">\n\n    <p class=\"nuvira-results-kicker\">AVALADO POR CLIENTES REALES</p>\n\n    <h2 class=\"nuvira-results-title\">\n      DESPUÉS DE INCORPORAR NMN+ A SU RUTINA, NUESTROS CLIENTES DESTACAN:\n    </h2>\n\n    <div class=\"nuvira-results-grid\">\n\n      <div class=\"nuvira-result-item\">\n        <div class=\"nuvira-result-percent\">91%</div>\n        <p>\n          Valoró la <strong>fórmula 4 en 1</strong> por combinar NMN, Resveratrol, Quercetina y TMG en una sola rutina.\n        </p>\n      </div>\n\n      <div class=\"nuvira-result-item\">\n        <div class=\"nuvira-result-percent\">87%</div>\n        <p>\n          Reportó sentirse con una <strong>rutina diaria más constante</strong> y fácil de mantener.\n        </p>\n      </div>\n\n      <div class=\"nuvira-result-item\">\n        <div class=\"nuvira-result-percent\">89%</div>\n        <p>\n          Dijo notar una mejor sensación de <strong>energía, vitalidad y bienestar general</strong> durante el día.\n        </p>\n      </div>\n\n    </div>\n\n    <p class=\"nuvira-results-note\">\n      * Basado en encuestas y testimonios de clientes. Los resultados individuales pueden variar.\n    </p>\n\n  </div>\n</section>\n\n<style>\n  .nuvira-results-section {\n    width: 100%;\n    background: #D7C09A;\n    padding: 58px 20px 42px 20px;\n    box-sizing: border-box;\n    font-family: inherit;\n  }\n\n  .nuvira-results-container {\n    max-width: 1280px;\n    margin: 0 auto;\n    text-align: center;\n  }\n\n  .nuvira-results-kicker {\n    margin: 0 0 34px 0;\n    color: #111111;\n    font-size: 15px;\n    line-height: 1.2;\n    font-weight: 900;\n    letter-spacing: 1.2px;\n    text-transform: uppercase;\n  }\n\n  .nuvira-results-title {\n    margin: 0 0 36px 0;\n    color: #111111;\n    font-size: 25px;\n    line-height: 1.35;\n    font-weight: 900;\n    letter-spacing: 1px;\n    text-transform: uppercase;\n  }\n\n  .nuvira-results-grid {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 54px;\n    align-items: center;\n    margin-bottom: 42px;\n  }\n\n  .nuvira-result-item {\n    display: grid;\n    grid-template-columns: auto 1fr;\n    gap: 26px;\n    align-items: center;\n    text-align: left;\n  }\n\n  .nuvira-result-percent {\n    color: #ffffff;\n    font-size: 54px;\n    line-height: 1;\n    font-weight: 900;\n    letter-spacing: -1px;\n    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.12);\n  }\n\n  .nuvira-result-item p {\n    margin: 0;\n    color: #111111;\n    font-size: 20px;\n    line-height: 1.25;\n    font-weight: 700;\n    letter-spacing: 0.2px;\n  }\n\n  .nuvira-result-item strong {\n    font-weight: 900;\n  }\n\n  .nuvira-results-note {\n    margin: 0;\n    color: #111111;\n    font-size: 12px;\n    line-height: 1.4;\n    font-weight: 700;\n    font-style: italic;\n    letter-spacing: 0.6px;\n    opacity: 0.85;\n  }\n\n  @media (max-width: 1000px) {\n    .nuvira-results-grid {\n      gap: 28px;\n    }\n\n    .nuvira-result-percent {\n      font-size: 46px;\n    }\n\n    .nuvira-result-item p {\n      font-size: 17px;\n    }\n  }\n\n  @media (max-width: 760px) {\n    .nuvira-results-section {\n      padding: 48px 18px 36px 18px;\n    }\n\n    .nuvira-results-kicker {\n      font-size: 13px;\n      margin-bottom: 24px;\n    }\n\n    .nuvira-results-title {\n      font-size: 21px;\n      margin-bottom: 30px;\n    }\n\n    .nuvira-results-grid {\n      grid-template-columns: 1fr;\n      gap: 28px;\n      max-width: 520px;\n      margin: 0 auto 34px auto;\n    }\n\n    .nuvira-result-item {\n      grid-template-columns: 90px 1fr;\n      gap: 18px;\n    }\n\n    .nuvira-result-percent {\n      font-size: 46px;\n    }\n\n    .nuvira-result-item p {\n      font-size: 16px;\n      line-height: 1.35;\n    }\n  }\n\n  @media (max-width: 480px) {\n    .nuvira-results-section {\n      padding: 42px 14px 32px 14px;\n    }\n\n    .nuvira-results-title {\n      font-size: 18px;\n      letter-spacing: 0.5px;\n    }\n\n    .nuvira-result-item {\n      grid-template-columns: 78px 1fr;\n      gap: 14px;\n    }\n\n    .nuvira-result-percent {\n      font-size: 40px;\n    }\n\n    .nuvira-result-item p {\n      font-size: 15px;\n    }\n\n    .nuvira-results-note {\n      font-size: 11px;\n    }\n  }\n</style>",
