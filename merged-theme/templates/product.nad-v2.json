    "custom_liquid_faqQDr": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "display_id": false,
        "visibility": "always-display",
        "custom_liquid": "<section class=\"nuvira-comparison-section\">\n  <div class=\"nuvira-comparison-container\">\n\n    <div class=\"nuvira-comparison-heading\">\n      <h2>LA DIFERENCIA</h2>\n      <h3>NUVIRA LAB</h3>\n    </div>\n\n    <div class=\"nuvira-comparison-grid\">\n\n      <div class=\"nuvira-comparison-card nuvira-main-card\">\n        <div class=\"nuvira-card-icon nuvira-check-main\">✓</div>\n\n        <h4>Por qué NMN+ encaja en tu rutina</h4>\n\n        <div class=\"nuvira-benefit-list\">\n          <div class=\"nuvira-benefit-item\">\n            <span>✓</span>\n            <p>Apoyo a la energía celular durante el día</p>\n          </div>\n\n          <div class=\"nuvira-benefit-item\">\n            <span>✓</span>\n            <p>Fórmula 4 en 1: NMN + Resveratrol + Quercetina + TMG</p>\n          </div>\n\n          <div class=\"nuvira-benefit-item\">\n            <span>✓</span>\n            <p>Rutina simple de solo 2 cápsulas al día</p>\n          </div>\n\n          <div class=\"nuvira-benefit-item\">\n            <span>✓</span>\n            <p>Ideal para apoyar vitalidad, concentración y bienestar diario</p>\n          </div>\n\n          <div class=\"nuvira-benefit-item\">\n            <span>✓</span>\n            <p>Una alternativa práctica a tomar varios suplementos por separado</p>\n          </div>\n\n          <div class=\"nuvira-benefit-item\">\n            <span>✓</span>\n            <p>60 cápsulas para una rutina constante y fácil de mantener</p>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"nuvira-comparison-card nuvira-secondary-card\">\n        <div class=\"nuvira-card-icon nuvira-cross-main\">×</div>\n\n        <h4>Otros suplementos</h4>\n\n        <div class=\"nuvira-other-list\">\n          <div class=\"nuvira-other-item\">\n            <span>×</span>\n            <p>Fórmulas básicas con un solo ingrediente</p>\n          </div>\n\n          <div class=\"nuvira-other-item\">\n            <span>×</span>\n            <p>Te obligan a combinar varios productos distintos</p>\n          </div>\n\n          <div class=\"nuvira-other-item\">\n            <span>×</span>\n            <p>Rutinas poco prácticas y difíciles de mantener</p>\n          </div>\n\n          <div class=\"nuvira-other-item\">\n            <span>×</span>\n            <p>No incluyen cofactores como TMG en la misma fórmula</p>\n          </div>\n\n          <div class=\"nuvira-other-item\">\n            <span>×</span>\n            <p>Menos enfoque en energía celular y bienestar integral</p>\n          </div>\n\n          <div class=\"nuvira-other-item\">\n            <span>×</span>\n            <p>Más cápsulas, más botes y más complicación diaria</p>\n          </div>\n        </div>\n      </div>\n\n    </div>\n\n  </div>\n</section>\n\n<style>\n  .nuvira-comparison-section {\n    width: 100%;\n    background: #ffffff;\n    padding: 70px 20px 80px;\n    box-sizing: border-box;\n    font-family: inherit;\n  }\n\n  .nuvira-comparison-container {\n    max-width: 1180px;\n    margin: 0 auto;\n  }\n\n  .nuvira-comparison-heading {\n    text-align: center;\n    margin-bottom: 58px;\n  }\n\n  .nuvira-comparison-heading h2 {\n    margin: 0;\n    color: #111111;\n    font-size: 34px;\n    line-height: 1.1;\n    font-weight: 900;\n    letter-spacing: 1.2px;\n    text-transform: uppercase;\n  }\n\n  .nuvira-comparison-heading h3 {\n    margin: 6px 0 0;\n    color: #D7C09A;\n    font-size: 34px;\n    line-height: 1.1;\n    font-weight: 900;\n    letter-spacing: 1.2px;\n    text-transform: uppercase;\n  }\n\n  .nuvira-comparison-grid {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 28px;\n    align-items: stretch;\n  }\n\n  .nuvira-comparison-card {\n    position: relative;\n    border-radius: 14px;\n    padding: 70px 24px 24px;\n    box-sizing: border-box;\n  }\n\n  .nuvira-main-card {\n    background: #111111;\n  }\n\n  .nuvira-secondary-card {\n    background: #eeeeee;\n  }\n\n  .nuvira-card-icon {\n    position: absolute;\n    top: -34px;\n    left: 50%;\n    transform: translateX(-50%);\n    width: 76px;\n    height: 76px;\n    border-radius: 50%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 44px;\n    font-weight: 900;\n    line-height: 1;\n    box-shadow: 0 14px 30px rgba(0, 0, 0, 0.12);\n  }\n\n  .nuvira-check-main {\n    background: #D7C09A;\n    color: #111111;\n  }\n\n  .nuvira-cross-main {\n    background: #ffffff;\n    color: #111111;\n  }\n\n  .nuvira-comparison-card h4 {\n    margin: 0 0 26px;\n    text-align: center;\n    font-size: 25px;\n    line-height: 1.2;\n    font-weight: 900;\n  }\n\n  .nuvira-main-card h4 {\n    color: #ffffff;\n  }\n\n  .nuvira-secondary-card h4 {\n    color: #111111;\n    text-transform: uppercase;\n  }\n\n  .nuvira-benefit-list,\n  .nuvira-other-list {\n    display: flex;\n    flex-direction: column;\n    gap: 12px;\n  }\n\n  .nuvira-benefit-item,\n  .nuvira-other-item {\n    display: flex;\n    align-items: center;\n    gap: 13px;\n    background: #ffffff;\n    border-radius: 9px;\n    padding: 16px 18px;\n    box-sizing: border-box;\n  }\n\n  .nuvira-benefit-item span {\n    width: 22px;\n    height: 22px;\n    min-width: 22px;\n    border-radius: 50%;\n    background: #D7C09A;\n    color: #111111;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 14px;\n    font-weight: 900;\n  }\n\n  .nuvira-other-item span {\n    width: 21px;\n    height: 21px;\n    min-width: 21px;\n    border-radius: 50%;\n    border: 1.5px solid #111111;\n    color: #111111;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 16px;\n    font-weight: 600;\n    line-height: 1;\n  }\n\n  .nuvira-benefit-item p,\n  .nuvira-other-item p {\n    margin: 0;\n    color: #1a1a1a;\n    font-size: 15px;\n    line-height: 1.35;\n    font-weight: 800;\n  }\n\n  .nuvira-other-item p {\n    font-weight: 500;\n  }\n\n  @media (max-width: 900px) {\n    .nuvira-comparison-section {\n      padding: 58px 16px 64px;\n    }\n\n    .nuvira-comparison-grid {\n      grid-template-columns: 1fr;\n      gap: 58px;\n      max-width: 620px;\n      margin: 0 auto;\n    }\n\n    .nuvira-comparison-heading {\n      margin-bottom: 52px;\n    }\n\n    .nuvira-comparison-heading h2,\n    .nuvira-comparison-heading h3 {\n      font-size: 28px;\n    }\n\n    .nuvira-comparison-card {\n      padding: 62px 18px 20px;\n    }\n\n    .nuvira-comparison-card h4 {\n      font-size: 22px;\n    }\n  }\n\n  @media (max-width: 480px) {\n    .nuvira-comparison-section {\n      padding: 50px 14px 58px;\n    }\n\n    .nuvira-comparison-heading h2,\n    .nuvira-comparison-heading h3 {\n      font-size: 25px;\n    }\n\n    .nuvira-card-icon {\n      width: 64px;\n      height: 64px;\n      top: -30px;\n      font-size: 36px;\n    }\n\n    .nuvira-benefit-item,\n    .nuvira-other-item {\n      padding: 14px 14px;\n      gap: 11px;\n    }\n\n    .nuvira-benefit-item p,\n    .nuvira-other-item p {\n      font-size: 14px;\n    }\n  }\n</style>",
        "color_scheme": "background-1",
        "padding_top": 40,
        "padding_bottom": 52
      }
