<style data-shopify="">.section-{{ section.id }}-padding {
    padding-top: 12px;
    padding-bottom: 9px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: 16px;
      padding-bottom: 12px;
    }
  }

  .color-scheme-{{ section.id }}.color-custom {
    --color-background: 255, 255, 255;
    --gradient-background: #ffffff;
    --color-foreground: 46, 42, 57;
  }
  .container-color-scheme-{{ section.id }}.color-custom {
    --color-background: 255, 255, 255;
    --gradient-background: #ffffff;
    --color-foreground: 46, 42, 57;
  }</style><div class="color-scheme-{{ section.id }} color-background-1 gradient content-for-grouping animate-section animate--hidden always-display">
  
