{{ 'tsl-page.css' | asset_url | stylesheet_tag }}
<script src="{{ 'tsl-page.js' | asset_url }}" defer></script>

<div class="tsl tsl-faq tsl-reveal" style="background-color: {{ section.settings.bg }};">
  <div class="tsl-faq__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="tsl__heading tsl-faq__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div data-tsl-toggle-single="{{ section.settings.single }}">
      {%- for block in section.blocks -%}
        <div class="tsl-faq__item" data-tsl-toggle-item {{ block.shopify_attributes }}>
          <button type="button" class="tsl-faq__head" data-tsl-toggle aria-expanded="false">
            <span>{{ block.settings.question }}</span>
            <span class="tsl-faq__toggle" aria-hidden="true">+</span>
          </button>
          <div class="tsl-faq__body">{{ block.settings.answer }}</div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{%- comment -%} FAQPage structured data — helps the answers surface in search. {%- endcomment -%}
{%- if section.settings.enable_schema and section.blocks.size > 0 -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {%- for block in section.blocks -%}
        {
          "@type": "Question",
          "name": {{ block.settings.question | json }},
          "acceptedAnswer": {
            "@type": "Answer",
            "text": {{ block.settings.answer | strip_html | json }}
          }
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "TSL FAQ",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Preguntas Frecuentes" },
    { "type": "checkbox", "id": "single", "label": "Only one open at a time", "default": true },
    { "type": "checkbox", "id": "enable_schema", "label": "Output FAQ structured data", "default": true },
    { "type": "color", "id": "bg", "label": "Background", "default": "#ffffff" }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "presets": [{ "name": "TSL FAQ" }]
}
{% endschema %}
