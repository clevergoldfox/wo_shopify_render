{{ 'tsl-page.css' | asset_url | stylesheet_tag }}
<script src="{{ 'tsl-page.js' | asset_url }}" defer></script>

{%- liquid
  assign current = product.selected_or_first_available_variant
  assign gallery_images = product.images
-%}

<div class="tsl tsl-pdp" data-tsl-section id="tsl-buybox">
  <div class="tsl-pdp__grid">

    {%- comment -%} ---------- Media / gallery ---------- {%- endcomment -%}
    <div class="tsl-pdp__media">
      <div data-tsl-gallery>
        <div class="tsl-gallery__main">
          {%- for image in gallery_images -%}
            {%- if forloop.first -%}
              {%- assign img_loading = 'eager' -%}
            {%- else -%}
              {%- assign img_loading = 'lazy' -%}
            {%- endif -%}
            <div class="tsl-gallery__slide{% if forloop.first %} is-active{% endif %}">
              {{ image | image_url: width: 1200 | image_tag:
                 loading: img_loading,
                 alt: image.alt | default: product.title,
                 widths: '530,800,1060,1200' }}
            </div>
          {%- else -%}
            <div class="tsl-gallery__slide is-active">
              {{ 'product-1' | placeholder_svg_tag }}
            </div>
          {%- endfor -%}

          {%- if gallery_images.size > 1 and section.settings.show_arrows -%}
            <button type="button" class="tsl-gallery__arrow tsl-gallery__arrow--prev" data-tsl-gallery-prev aria-label="Previous image">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
            </button>
            <button type="button" class="tsl-gallery__arrow tsl-gallery__arrow--next" data-tsl-gallery-next aria-label="Next image">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
            </button>
          {%- endif -%}
        </div>

        {%- if gallery_images.size > 1 -%}
          <div class="tsl-gallery__thumbs">
            {%- for image in gallery_images -%}
              <button type="button" class="tsl-gallery__thumb{% if forloop.first %} is-active{% endif %}" aria-label="Imagen {{ forloop.index }}">
                {{ image | image_url: width: 200 | image_tag: loading: 'lazy', alt: '' }}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} ---------- Buy box ---------- {%- endcomment -%}
    <div class="tsl-pdp__info">
      {%- for block in section.blocks -%}
        {%- case block.type -%}

          {%- when 'pills' -%}
            <div class="tsl-pdp__eyebrow" {{ block.shopify_attributes }}>
              {%- assign pills = block.settings.pills | split: '|' -%}
              {%- for pill in pills -%}
                <span class="tsl-pdp__pill">
                  {% render 'tsl-icon', icon: 'check-circle' %}
                  {{ pill | strip }}
                </span>
              {%- endfor -%}
            </div>

          {%- when 'rating' -%}
            <div class="tsl-pdp__rating" {{ block.shopify_attributes }}>
              <span class="tsl-pdp__stars" role="img" aria-label="{{ block.settings.rating }} / 5">
                {%- for i in (1..5) -%}{% render 'tsl-icon', icon: 'star' %}{%- endfor -%}
              </span>
              <span>{{ block.settings.rating_text }}</span>
            </div>

          {%- when 'title' -%}
            <h1 class="tsl-pdp__title" {{ block.shopify_attributes }}>
              {{ block.settings.title | default: product.title }}
            </h1>

          {%- when 'price' -%}
            <div class="tsl-pdp__price" {{ block.shopify_attributes }}>
              <span data-tsl-price>{{ current.price | money }}</span>
              <span class="tsl-pdp__price-compare" data-tsl-compare
                {% unless current.compare_at_price > current.price %}hidden{% endunless %}>
                {%- if current.compare_at_price > current.price -%}{{ current.compare_at_price | money }}{%- endif -%}
              </span>
              {%- if block.settings.save_badge != blank -%}
                <span class="tsl-pdp__save">{{ block.settings.save_badge }}</span>
              {%- endif -%}
            </div>

          {%- when 'bullets' -%}
            <ul class="tsl-pdp__bullets" {{ block.shopify_attributes }}>
              {%- assign rows = block.settings.bullets | newline_to_br | split: '<br />' -%}
              {%- for row in rows -%}
                {%- assign line = row | strip_newlines | strip -%}
                {%- if line != blank -%}
                  <li>{% render 'tsl-icon', icon: 'check-circle' %}<span>{{ line }}</span></li>
                {%- endif -%}
              {%- endfor -%}
            </ul>

          {%- when 'variants' -%}
            {%- if product.variants.size > 1 -%}
              <div class="tsl-variants" data-tsl-variants {{ block.shopify_attributes }}>
                {%- for variant in product.variants -%}
                  <label class="tsl-variant">
                    <input class="tsl-variant__radio" type="radio" name="tsl-variant-{{ section.id }}"
                           value="{{ variant.id }}"
                           data-price="{{ variant.price | money }}"
                           data-compare="{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money }}{% endif %}"
                           {% if variant == current %}checked{% endif %}
                           {% unless variant.available %}disabled{% endunless %}>
                    <span class="tsl-variant__body">
                      <span class="tsl-variant__name">
                        {{ variant.title }}
                        {%- if forloop.index == block.settings.highlight_index -%}
                          <span class="tsl-variant__tag">{{ block.settings.highlight_label }}</span>
                        {%- endif -%}
                      </span>
                      {%- unless variant.available -%}
                        <span class="tsl-variant__meta">Agotado</span>
                      {%- endunless -%}
                    </span>
                    <span class="tsl-variant__price">{{ variant.price | money }}</span>
                  </label>
                {%- endfor -%}
              </div>
            {%- endif -%}

          {%- when 'add_to_cart' -%}
            <div {{ block.shopify_attributes }}>
              {%- form 'product', product, id: 'tsl-product-form', class: 'tsl-pdp__form' -%}
                <input type="hidden" name="id" value="{{ current.id }}" data-tsl-variant-id>
                <input type="hidden" name="quantity" value="1">
                <button type="submit" name="add" class="tsl__btn tsl__btn--block"
                        {% unless product.available %}disabled{% endunless %}>
                  {%- if product.available -%}
                    {{ block.settings.button_label }}
                  {%- else -%}
                    Agotado
                  {%- endif -%}
                </button>
              {%- endform -%}
              {%- if block.settings.note != blank -%}
                <p class="tsl-pdp__atc-note">
                  {% render 'tsl-icon', icon: 'refresh' %}{{ block.settings.note }}
                </p>
              {%- endif -%}
            </div>

          {%- when 'promo' -%}
            <div class="tsl-pdp__promo" {{ block.shopify_attributes }}>
              <div class="tsl-pdp__promo-title">{{ block.settings.heading }}</div>
              <div class="tsl-pdp__promo-text">{{ block.settings.text }}</div>
            </div>

          {%- when 'guarantee_badge' -%}
            <div class="tsl-pdp__badges" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 200 | image_tag: loading: 'lazy', alt: block.settings.heading }}
              {%- endif -%}
              <div class="tsl-pdp__badges-text">
                <strong>{{ block.settings.heading }}</strong>
                <span>{{ block.settings.text }}</span>
              </div>
            </div>

          {%- when 'tabs' -%}
            <div class="tsl-tabs" data-tsl-tabs {{ block.shopify_attributes }}>
              <div class="tsl-tabs__nav" role="tablist">
                {%- for n in (1..3) -%}
                  {%- assign key = 'tab_' | append: n | append: '_label' -%}
                  {%- assign label = block.settings[key] -%}
                  {%- if label != blank -%}
                    <button type="button" class="tsl-tabs__btn{% if forloop.first %} is-active{% endif %}"
                            role="tab" aria-selected="{{ forloop.first }}" data-tsl-tab="{{ n }}">{{ label }}</button>
                  {%- endif -%}
                {%- endfor -%}
              </div>
              {%- for n in (1..3) -%}
                {%- assign ckey = 'tab_' | append: n | append: '_content' -%}
                {%- assign content = block.settings[ckey] -%}
                {%- if content != blank -%}
                  <div class="tsl-tabs__panel{% if forloop.first %} is-active{% endif %}" role="tabpanel" data-tsl-panel="{{ n }}">
                    {{ content }}
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>

          {%- when 'collapsible' -%}
            <div class="tsl-collapse" data-tsl-toggle-single="false" {{ block.shopify_attributes }}>
              <div class="tsl-collapse__item" data-tsl-toggle-item>
                <button type="button" class="tsl-collapse__head" data-tsl-toggle aria-expanded="false">
                  <span>{{ block.settings.heading }}</span>
                  <span class="tsl-collapse__icon" aria-hidden="true">+</span>
                </button>
                <div class="tsl-collapse__body">{{ block.settings.content }}</div>
              </div>
            </div>

          {%- when 'payment_icons' -%}
            <div class="tsl-pdp__payments" {{ block.shopify_attributes }}>
              {%- for type in shop.enabled_payment_types -%}
                {{ type | payment_type_svg_tag: class: 'tsl-pdp__payment-icon' }}
              {%- endfor -%}
            </div>

        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "TSL Product details",
  "tag": "section",
  "class": "tsl-section",
  "settings": [
    { "type": "checkbox", "id": "show_arrows", "label": "Show gallery arrows", "default": true }
  ],
  "blocks": [
    {
      "type": "pills",
      "name": "Top pills",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "pills", "label": "Pills (separate with |)", "default": "Soporte de Desintoxicación de Hígado|Despeja la Niebla Mental" }
      ]
    },
    {
      "type": "rating",
      "name": "Rating",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "rating", "label": "Rating value", "default": "4.7" },
        { "type": "text", "id": "rating_text", "label": "Rating text", "default": "Calificado 4.7 (69,708+ Clientes)" }
      ]
    },
    {
      "type": "title",
      "name": "Title",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "title", "label": "Heading override", "info": "Leave blank to use the product title.", "default": "NAC600 & NAD Daily Complex" }
      ]
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "save_badge", "label": "Save badge text" }
      ]
    },
    {
      "type": "bullets",
      "name": "Benefit bullets",
      "limit": 1,
      "settings": [
        { "type": "textarea", "id": "bullets", "label": "Bullets (one per line)", "default": "El Mismo Compuesto que Usan los Hospitales para Emergencias de Higado\nElimina el Alcohol, Tylenol y Años de Acumulación Tóxica\nApoya la Función Cerebral, la Salud Respiratoria y el Metabolismo\nDespeja la Niebla Mental de la Tarde\nSuave con tu Estómago (Aceite MCT, No Polvo Seco)\nDosis Clínica de 600mg — Sin Subdosificación" }
      ]
    },
    {
      "type": "variants",
      "name": "Bundle / variant selector",
      "limit": 1,
      "settings": [
        { "type": "range", "id": "highlight_index", "label": "Highlight option number", "min": 0, "max": 5, "step": 1, "default": 2 },
        { "type": "text", "id": "highlight_label", "label": "Highlight label", "default": "MÁS POPULAR" }
      ]
    },
    {
      "type": "add_to_cart",
      "name": "Add to cart",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "button_label", "label": "Button label", "default": "AGREGAR AL CARRITO" },
        { "type": "text", "id": "note", "label": "Note under button", "default": "Devoluciones Gratuitas en 30 Días" }
      ]
    },
    {
      "type": "payment_icons",
      "name": "Payment icons",
      "limit": 1,
      "settings": []
    },
    {
      "type": "promo",
      "name": "Promo callout",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "REBAJAS DEL DÍA DE LA INDEPENDENCIA" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Nuestros mayores ahorros del verano están aquí. Abastece tu despensa, ahorra más y disfruta de ofertas por tiempo limitado antes de que desaparezcan." }
      ]
    },
    {
      "type": "guarantee_badge",
      "name": "Guarantee badge",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Badge image" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Menos del 1%" },
        { "type": "text", "id": "text", "label": "Text", "default": "de los clientes reclaman nuestra Garantía de devolución de dinero" }
      ]
    },
    {
      "type": "tabs",
      "name": "Tabs",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "tab_1_label", "label": "Tab 1 label", "default": "Expert Reviews" },
        { "type": "richtext", "id": "tab_1_content", "label": "Tab 1 content" },
        { "type": "text", "id": "tab_2_label", "label": "Tab 2 label", "default": "Comparison" },
        { "type": "html", "id": "tab_2_content", "label": "Tab 2 content (HTML)" },
        { "type": "text", "id": "tab_3_label", "label": "Tab 3 label", "default": "Ingredients" },
        { "type": "html", "id": "tab_3_content", "label": "Tab 3 content (HTML)" }
      ]
    },
    {
      "type": "collapsible",
      "name": "Collapsible row",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "html", "id": "content", "label": "Content" }
      ]
    }
  ],
  "presets": [{ "name": "TSL Product details" }]
}
{% endschema %}
