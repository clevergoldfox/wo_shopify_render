<link href="{{ 'section-image-with-text.css' | asset_url }}" rel="stylesheet" type="text/css" media="all" />

<style data-shopify></style><div
  id="section-{{ section.id }}"
  class="section section--padding image-with-text image-with-text--image-right color-scheme-1"
  style="--section-padding-top: 40px; --section-padding-bottom: 40px;"
>
  <div class="section__container page-width page-width--fixed">
    <div
      class="image-with-text__wrapper flex flex-col md:flex-row gap-y-6"
      style="--image-width: 50%;"
    >
      <div
        class="image-with-text__media self-center relative order-first md:order-last"
      >
        <div class="hover-wrapper blocks-radius">
          <motion-element
            data-motion="zoom-out"
            data-motion-delay="0"
            class="block media-wrapper"
            style="--aspect-ratio: 1.4997000599880024;"
          ><img src="{{ 'Wellness-Market_w2000.png' | asset_url }}" alt="Micro Ingredients" srcset="{{ 'Wellness-Market_w300.png' | asset_url }} 300w, {{ 'Wellness-Market_w400.png' | asset_url }} 400w, {{ 'Wellness-Market_w500.png' | asset_url }} 500w, {{ 'Wellness-Market_w600.png' | asset_url }} 600w, {{ 'Wellness-Market_w700.png' | asset_url }} 700w, {{ 'Wellness-Market_w800.png' | asset_url }} 800w, {{ 'Wellness-Market_w900.png' | asset_url }} 900w, {{ 'Wellness-Market_w1000.png' | asset_url }} 1000w, {{ 'Wellness-Market_w1200.png' | asset_url }} 1200w, {{ 'Wellness-Market_w1400.png' | asset_url }} 1400w, {{ 'Wellness-Market_w1600.png' | asset_url }} 1600w, {{ 'Wellness-Market_w1800.png' | asset_url }} 1800w, {{ 'Wellness-Market_w2000.png' | asset_url }} 2000w" width="2500" height="1667" loading="lazy" fetchpriority="low" sizes="(min-width: 768px) calc(min(1600px, 100vw) * 50 / 100), calc(100vw - 3rem)" class="hover-scale-up" is="image-lazy"></motion-element></div></div>
      <div class="image-with-text__inner flex-1 md:flex items-center">
        <div class="image-with-text__content w-full rich-text md:text-left text-left"><motion-element
                  class="rich-text__subheading text-subheading block"
                  data-motion="fade-up"
                  data-motion-delay="50"
                  
                >
                  Todo con certificación ecológica
                </motion-element><h2
                  class="rich-text__heading h1"
                  
                >
                  <motion-element data-motion="fade-up" data-motion-delay="100" class="block">
                    
Somos tu mercado moderno de bienestar
                  </motion-element>
                </h2><motion-element
                  class="block rich-text__text rte"
                  data-motion="fade-up"
                  data-motion-delay="150"
                  
                >
                  <p>Sin extras innecesarios. Sin fórmulas complicadas. Solo los ingredientes limpios, eficaces y confiables que buscas, probados por laboratorios independientes, por supuesto.<br/><br/></p>
                </motion-element></div>
      </div>
    </div>
  </div>
</div>

<style> @media (min-width: 1024px) {#shopify-section-{{ section.id }} .image-with-text__wrapper {padding-inline: 5rem; } #shopify-section-{{ section.id }} .image-with-text__content {--text-margin-top: 2rem; }} #shopify-section-{{ section.id }} .image-with-text__content {max-width: 52rem;} </style>

{% schema %}
{
  "name": "Col Image With Text 2",
  "class": "col-scope",
  "settings": []
}
{% endschema %}
