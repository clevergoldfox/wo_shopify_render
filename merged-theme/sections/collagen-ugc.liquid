{%- comment -%}
  Social-proof photo grid. Each block is one image with an optional link.
{%- endcomment -%}

<section class="section">
  <div class="wrap">
    {%- if section.settings.heading != blank -%}
      <div class="section-head">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.subheading != blank -%}<p>{{ section.settings.subheading }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    <div class="ugc">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}
           {% if block.settings.link != blank %}target="_blank" rel="noopener"{% endif %}>
          {%- if block.settings.image -%}
            <img src="{{ block.settings.image | image_url: width: 400 }}"
                 srcset="{{ block.settings.image | image_url: width: 200 }} 200w,
                         {{ block.settings.image | image_url: width: 400 }} 400w"
                 sizes="(min-width: 900px) 16vw, 33vw"
                 alt="{{ block.settings.image.alt | default: 'Customer photo' | escape }}"
                 width="400" height="400" loading="lazy">
          {%- else -%}
            {{ 'image' | placeholder_svg_tag }}
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Social proof grid",
  "tag": "section",
  "max_blocks": 18,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "#YourHashtag" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From the community" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Tag us and your photo could land here." }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Social proof grid",
      "blocks": [
        { "type": "photo" }, { "type": "photo" }, { "type": "photo" },
        { "type": "photo" }, { "type": "photo" }, { "type": "photo" },
        { "type": "photo" }, { "type": "photo" }, { "type": "photo" },
        { "type": "photo" }, { "type": "photo" }, { "type": "photo" }
      ]
    }
  ]
}
{% endschema %}
