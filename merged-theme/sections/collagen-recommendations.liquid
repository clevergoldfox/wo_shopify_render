{%- comment -%}
  "You may also like" carousel.
  Uses Shopify's product recommendations when available, and falls back
  to a hand-picked collection when the recommendations API returns nothing.
{%- endcomment -%}

{%- liquid
  assign items = recommendations.products
  if recommendations.performed and recommendations.products_count == 0
    assign items = section.settings.fallback.products
  elsif recommendations.performed == false
    assign items = section.settings.fallback.products
  endif
-%}

<section class="section"
  {% if recommendations.performed == false %}
    data-recommendations-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.count }}"
  {% endif %}>
  <div class="wrap">
    {%- if section.settings.heading != blank -%}
      <div class="section-head"><h2>{{ section.settings.heading }}</h2></div>
    {%- endif -%}

    <div class="carousel" data-carousel>
      <button class="carousel__nav carousel__nav--prev" data-carousel-nav="prev" aria-label="Scroll left" type="button">
        <svg width="20" height="20"><use href="#i-chev-left"/></svg>
      </button>

      <div class="carousel__track" data-carousel-track>
        {%- for item in items limit: section.settings.count -%}
          {%- assign iv = item.selected_or_first_available_variant -%}
          <article class="card">
            <a href="{{ item.url }}" class="card__media">
              {%- if iv.compare_at_price > iv.price -%}
                {%- assign pct = iv.compare_at_price | minus: iv.price | times: 100.0 | divided_by: iv.compare_at_price | round -%}
                <span class="card__flag">-{{ pct }}%</span>
              {%- endif -%}
              {%- if item.featured_image -%}
                <img src="{{ item.featured_image | image_url: width: 500 }}"
                     srcset="{{ item.featured_image | image_url: width: 300 }} 300w,
                             {{ item.featured_image | image_url: width: 500 }} 500w"
                     sizes="220px"
                     alt="{{ item.featured_image.alt | escape }}"
                     width="500" height="500" loading="lazy">
              {%- else -%}
                {{ 'product-2' | placeholder_svg_tag }}
              {%- endif -%}
              <span class="card__quick">{{ section.settings.quick_label }}</span>
            </a>
            <div class="card__body">
              <h3 class="card__title"><a href="{{ item.url }}">{{ item.title }}</a></h3>
              <p class="card__price">
                <b>{{ iv.price | money }}</b>
                {%- if iv.compare_at_price > iv.price -%}<s>{{ iv.compare_at_price | money }}</s>{%- endif -%}
              </p>
            </div>
          </article>
        {%- endfor -%}
      </div>

      <button class="carousel__nav carousel__nav--next" data-carousel-nav="next" aria-label="Scroll right" type="button">
        <svg width="20" height="20"><use href="#i-chev-right"/></svg>
      </button>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "You may also like",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "You may also like" },
    { "type": "range", "id": "count", "label": "Products to show", "min": 4, "max": 12, "step": 1, "default": 8 },
    { "type": "text", "id": "quick_label", "label": "Hover label", "default": "Quick add" },
    { "type": "collection", "id": "fallback", "label": "Fallback collection",
      "info": "Used when Shopify has no recommendations for this product yet." }
  ],
  "presets": [{ "name": "You may also like" }]
}
{% endschema %}
