{%- comment -%}
  FAQ accordion. Emits FAQPage structured data alongside the markup.
{%- endcomment -%}

<section class="section{% if section.settings.cream %} section--cream{% endif %}">
  <div class="wrap">
    {%- if section.settings.heading != blank -%}
      <div class="section-head"><h2>{{ section.settings.heading }}</h2></div>
    {%- endif -%}

    <div class="faq" data-faq="{% if section.settings.single_open %}single{% else %}multi{% endif %}">
      {%- for block in section.blocks -%}
        <div class="faq__item{% if forloop.first and section.settings.open_first %} is-open{% endif %}"
             {{ block.shopify_attributes }}>
          <button class="faq__q" data-faq-q type="button"
                  aria-expanded="{% if forloop.first and section.settings.open_first %}true{% else %}false{% endif %}">
            {{ block.settings.question }}
            <span class="faq__icon"><svg width="16" height="16"><use href="#i-plus"/></svg></span>
          </button>
          <div class="faq__a"><div>{{ block.settings.answer }}</div></div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{%- if section.blocks.size > 0 -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {%- for block in section.blocks -%}
        {
          "@type": "Question",
          "name": {{ block.settings.question | json }},
          "acceptedAnswer": {
            "@type": "Answer",
            "text": {{ block.settings.answer | strip_html | json }}
          }
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "FAQ accordion",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Common questions" },
    { "type": "checkbox", "id": "cream", "label": "Cream background", "default": true },
    { "type": "checkbox", "id": "single_open", "label": "Only one answer open at a time", "default": true },
    { "type": "checkbox", "id": "open_first", "label": "Open the first item by default", "default": true }
  ],
  "blocks": [
    {
      "type": "qa",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How long before I notice a difference?" },
        { "type": "richtext", "id": "answer", "label": "Answer",
          "default": "<p>Hair and nails usually respond first, around week four.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ accordion",
      "blocks": [{ "type": "qa" }, { "type": "qa" }, { "type": "qa" }, { "type": "qa" }]
    }
  ]
}
{% endschema %}
