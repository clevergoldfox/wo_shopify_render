{{ 'tsl-page.css' | asset_url | stylesheet_tag }}
<script src="{{ 'tsl-page.js' | asset_url }}" defer></script>

<div class="tsl tsl-stats tsl-reveal" style="background-color: {{ section.settings.bg }};">
  <div class="tsl-stats__grid">
    {%- if section.settings.image != blank -%}
      <div class="tsl-stats__media">
        {{ section.settings.image | image_url: width: 1200 | image_tag:
           loading: 'lazy', alt: section.settings.heading, widths: '500,800,1200' }}
      </div>
    {%- endif -%}

    <div class="tsl-stats__content">
      {%- if section.settings.heading != blank -%}
        <h2 class="tsl__heading tsl-stats__heading">
          {{ section.settings.heading }}
          {%- if section.settings.heading_accent != blank -%}
            <span class="tsl__accent">{{ section.settings.heading_accent }}</span>
          {%- endif -%}
        </h2>
      {%- endif -%}

      {%- for block in section.blocks -%}
        <div class="tsl-stat" {{ block.shopify_attributes }}>
          <div class="tsl-stat__num" data-tsl-count="{{ block.settings.value }}" data-tsl-count-suffix="{{ block.settings.suffix }}">0{{ block.settings.suffix }}</div>
          <div>
            <h3 class="tsl-stat__title">{{ block.settings.title }}</h3>
            <p class="tsl-stat__text">{{ block.settings.text }}</p>
          </div>
        </div>
      {%- endfor -%}

      {%- if section.settings.footnote != blank -%}
        <p class="tsl-stats__footnote">{{ section.settings.footnote }}</p>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "TSL Statistics",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Lo que Más de 69,708 Clientes" },
    { "type": "text", "id": "heading_accent", "label": "Accent heading", "default": "Están Experimentando" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "footnote", "label": "Footnote", "default": "*Basado en estudios internos y encuestas de retroalimentación de clientes." },
    { "type": "color", "id": "bg", "label": "Background", "default": "#ffffff" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Statistic",
      "settings": [
        { "type": "number", "id": "value", "label": "Value (number only)", "default": 91 },
        { "type": "text", "id": "suffix", "label": "Suffix", "default": "%" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [{ "name": "TSL Statistics" }]
}
{% endschema %}
