<link href="{{ 'component-multicolumn-card.css' | asset_url }}" rel="stylesheet" type="text/css" media="all" />


<style data-shopify>
  .section-{{ section.id }} {
    --section-padding-top: 50px;
    --section-padding-bottom: 50px;
    --f-columns-mobile: 1;
    --f-columns-md: 3;
    --f-columns-lg: 3;
    --f-columns-xl: 3;
    --icon-color: #1d349a;
  }
</style>

<div class="section section-{{ section.id }} section--padding multicolumn-icon section-header-vertical color-scheme-8">
  <div class="section__container page-width page-width--fixed md:items-center">
    <div class="section__heading">
      

    </div>
    <multicolumn-icon
      class="section__content block f-grid--gap-large f-grid--row-gap-inherit"
      data-section-id="{{ section.id }}"
    >
      <div class="multicolumn__items f-grid"><div
            class="f-column relative multicolumn-card-wrapper color-scheme-inherit"
            
            data-index="0"
          >
            <div
              class="multicolumn-card multicolumn-card--image-icon multicolumn-card--layout-top flex gap-x-3  items-center flex-col text-center color-scheme-8 color-scheme-inherit h-full"
              style="--img-max: 110px;--img-max-mb: 60px;"
            >
              <div class="multicolumn-card__image shrink-0">
                <motion-element
                  class="block w-full h-full"
                  data-motion="zoom-out-sm"
                  style="--aspect-ratio: 1.0;"
                ><picture class="card-media__media media-wrapper">
                      <img src="{{ 'Icon-3_286a542c-bd9c-4286-b066-81f72d462a92_w1100.png' | asset_url }}" alt="Origen directo" srcset="{{ 'Icon-3_286a542c-bd9c-4286-b066-81f72d462a92_w40.png' | asset_url }} 40w, {{ 'Icon-3_286a542c-bd9c-4286-b066-81f72d462a92_w60.png' | asset_url }} 60w, {{ 'Icon-3_286a542c-bd9c-4286-b066-81f72d462a92_w80.png' | asset_url }} 80w, {{ 'Icon-3_286a542c-bd9c-4286-b066-81f72d462a92_w120.png' | asset_url }} 120w, {{ 'Icon-3_286a542c-bd9c-4286-b066-81f72d462a92_w165.png' | asset_url }} 165w, {{ 'Icon-3_286a542c-bd9c-4286-b066-81f72d462a92_w360.png' | asset_url }} 360w, {{ 'Icon-3_286a542c-bd9c-4286-b066-81f72d462a92_w535.png' | asset_url }} 535w, {{ 'Icon-3_286a542c-bd9c-4286-b066-81f72d462a92_w750.png' | asset_url }} 750w, {{ 'Icon-3_286a542c-bd9c-4286-b066-81f72d462a92_w940.png' | asset_url }} 940w, {{ 'Icon-3_286a542c-bd9c-4286-b066-81f72d462a92_w1100.png' | asset_url }} 1100w" width="1100" height="1100" loading="lazy" class="motion-reduce absolute inset-0 w-full h-full" is="image-lazy" sizes="(min-width: 768px) 110px, 60px">
                    </picture></motion-element>
              </div>
              <div class="multicolumn-card__info rich-text rich-text--tight flex-1 flex flex-col items-center"><h3 class="multicolumn-card__title rich-text__heading font-heading h5">
                    
Origen directo
                  </h3><div class="multicolumn-card__text rich-text__text rte text-base text-subtext">
                    <p>Nos dedicamos a usar ingredientes naturales de alta calidad</p>
                  </div></div>
            </div>
            
          </div><div
