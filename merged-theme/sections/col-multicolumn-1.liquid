                ><picture class="card-media__media media-wrapper">
                      <img src="{{ 'Icon-1_609a8ed0-417c-4e37-810d-38f556d4959d_w1100.png' | asset_url }}" alt="Ingredientes confiables" srcset="{{ 'Icon-1_609a8ed0-417c-4e37-810d-38f556d4959d_w40.png' | asset_url }} 40w, {{ 'Icon-1_609a8ed0-417c-4e37-810d-38f556d4959d_w60.png' | asset_url }} 60w, {{ 'Icon-1_609a8ed0-417c-4e37-810d-38f556d4959d_w80.png' | asset_url }} 80w, {{ 'Icon-1_609a8ed0-417c-4e37-810d-38f556d4959d_w120.png' | asset_url }} 120w, {{ 'Icon-1_609a8ed0-417c-4e37-810d-38f556d4959d_w165.png' | asset_url }} 165w, {{ 'Icon-1_609a8ed0-417c-4e37-810d-38f556d4959d_w360.png' | asset_url }} 360w, {{ 'Icon-1_609a8ed0-417c-4e37-810d-38f556d4959d_w535.png' | asset_url }} 535w, {{ 'Icon-1_609a8ed0-417c-4e37-810d-38f556d4959d_w750.png' | asset_url }} 750w, {{ 'Icon-1_609a8ed0-417c-4e37-810d-38f556d4959d_w940.png' | asset_url }} 940w, {{ 'Icon-1_609a8ed0-417c-4e37-810d-38f556d4959d_w1100.png' | asset_url }} 1100w" width="1100" height="1095" loading="lazy" class="motion-reduce absolute inset-0 w-full h-full" is="image-lazy" sizes="(min-width: 768px) 110px, 60px">
