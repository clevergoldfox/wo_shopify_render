        var instance = instances[i];
        var renderEl = instance.querySelector('.atlas-bundler-render');
        var notice = instance.querySelector('.atlas-bundler-duplicate-notice');
        if (instance === winner) {
          if (renderEl) {
            if (renderEl.id !== 'bundler-v3') { renderEl.id = 'bundler-v3'; }
            renderEl.style.display = '';
            window.Atlas.bundler.EL = renderEl;
          }
