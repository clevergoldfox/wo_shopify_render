{{ 'tsl-page.css' | asset_url | stylesheet_tag }}

<div class="tsl tsl-promo" style="background-color: {{ section.settings.bg }}; color: {{ section.settings.text_color }};">
  <div class="tsl-promo__inner">
    {%- if section.settings.show_icon -%}
      {% render 'tsl-icon', icon: 'sparkle', class: 'tsl-promo__icon' %}
    {%- endif -%}
    <span>{{ section.settings.text }}</span>
  </div>
</div>

{% schema %}
{
  "name": "TSL Promo bar",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "BUY 2 GET 1 FREE THIS SUMMER" },
    { "type": "checkbox", "id": "show_icon", "label": "Show icon", "default": false },
    { "type": "color", "id": "bg", "label": "Background", "default": "#0f2945" },
    { "type": "color", "id": "text_color", "label": "Text colour", "default": "#ffffff" }
  ],
  "presets": [{ "name": "TSL Promo bar" }]
}
{% endschema %}
