        "display_id": false,
        "visibility": "always-display",
        "custom_liquid": "<!-- NUVIRA-STYLE COUNTDOWN BAR (compact, centered) -->\n<div class=\"aa-countbar\"\n     data-mode=\"evergreen\"\n     data-duration-minutes=\"1440\"\n     data-hide-days-when-zero=\"false\">\n  <div class=\"aa-countbar__inner\">\n    <span class=\"aa-countbar__label\">LA OFERTA ACABA EN</span>\n\n    <div class=\"aa-countbar__timer\" aria-live=\"polite\">\n      <div class=\"aa-unit aa-days\" data-unit=\"days\">\n        <div class=\"aa-unit__num\" id=\"aaDays\">00</div>\n        <div class=\"aa-unit__txt\">DÍAS</div>\n      </div>\n\n      <div class=\"aa-unit\">\n        <div class=\"aa-unit__num\" id=\"aaHrs\">00</div>\n        <div class=\"aa-unit__txt\">HRS</div>\n      </div>\n\n      <div class=\"aa-unit\">\n        <div class=\"aa-unit__num\" id=\"aaMin\">00</div>\n        <div class=\"aa-unit__txt\">MIN</div>\n      </div>\n\n      <div class=\"aa-unit\">\n        <div class=\"aa-unit__num\" id=\"aaSec\">00</div>\n        <div class=\"aa-unit__txt\">SEC</div>\n      </div>\n    </div>\n  </div>\n</div>\n\n<style>\n  /* ====== CONFIG RÁPIDA ====== */\n  :root{\n    --aa-bg: #d7c09a;   /* beige arena */\n    --aa-txt: #ffffff;  /* blanco */\n  }\n\n  /* Barra base */\n  .aa-countbar{\n    background: var(--aa-bg);\n    color: var(--aa-txt);\n    width: 100%;\n    margin: 0 !important;\n    padding: 0 !important;\n  }\n\n  /* Contenido centrado y compacto */\n  .aa-countbar__inner{\n    max-width: none !important;\n    margin: 0 auto !important;\n    padding: 6px 12px !important;     /* ALTURA de la barra */\n    display: flex !important;\n    align-items: center !important;\n    justify-content: center !important;\n    gap: 12px !important;             /* un pelín más aire, sigue “pegado” */\n    flex-wrap: nowrap !important;\n  }\n\n  .aa-countbar__label{\n    font-weight: 800 !important;       /* más “réplica” */\n    letter-spacing: .6px !important;   /* más “réplica” */\n    text-transform: uppercase !important;\n    font-size: 13px !important;        /* +1 */\n    line-height: 1 !important;\n    white-space: nowrap !important;\n    margin: 0 !important;\n    padding: 0 !important;\n  }\n\n  .aa-countbar__timer{\n    display: flex !important;\n    align-items: center !important;\n    gap: 12px !important;              /* +2 */\n  }\n\n  .aa-unit{\n    display: grid !important;\n    justify-items: center !important;\n    gap: 1px !important;\n    min-width: auto !important;\n  }\n\n  .aa-unit__num{\n    font-weight: 800 !important;\n    font-size: 13px !important;        /* +1 */\n    line-height: 1 !important;\n    letter-spacing: .6px !important;   /* más “réplica” */\n  }\n\n  .aa-unit__txt{\n    font-size: 10px !important;        /* +1 */\n    font-weight: 800 !important;       /* más “réplica” */\n    line-height: 1 !important;\n    opacity: .98 !important;\n    letter-spacing: .6px !important;\n    text-transform: uppercase !important;\n  }\n\n  /* Móvil */\n  @media (max-width: 520px){\n    .aa-countbar__inner{\n      padding: 6px 10px !important;\n      gap: 10px !important;\n      flex-wrap: wrap !important;\n    }\n    .aa-countbar__timer{ gap: 10px !important; }\n    .aa-countbar__label{ font-size: 12px !important; }\n    .aa-unit__num{ font-size: 12px !important; }\n    .aa-unit__txt{ font-size: 9px !important; }\n  }\n</style>\n\n<script>\n(function(){\n  const bar = document.querySelector('.aa-countbar');\n  if(!bar) return;\n\n  /* 1) Quitar el padding/margen del WRAPPER de la sección Shopify */\n  const section = bar.closest('.shopify-section');\n  if(section){\n    section.style.paddingTop = '0';\n    section.style.paddingBottom = '0';\n    section.style.marginTop = '0';\n    section.style.marginBottom = '0';\n  }\n\n  /* Algunos themes meten padding en un contenedor interno: lo neutralizamos */\n  const innerWrap = bar.closest('.section, .section-padding, .page-width, .container');\n  if(innerWrap && innerWrap !== bar){\n    innerWrap.style.paddingTop = '0';\n    innerWrap.style.paddingBottom = '0';\n    innerWrap.style.marginTop = '0';\n    innerWrap.style.marginBottom = '0';\n    innerWrap.style.maxWidth = 'none';\n  }\n\n  /* 2) Lógica del contador */\n  const mode = (bar.dataset.mode || 'evergreen').toLowerCase();\n  const durationMinutes = parseInt(bar.dataset.durationMinutes || '1440', 10);\n  const hideDaysWhenZero = (bar.dataset.hideDaysWhenZero || 'false') === 'true';\n\n  const daysEl = document.getElementById('aaDays');\n  const hrsEl  = document.getElementById('aaHrs');\n  const minEl  = document.getElementById('aaMin');\n  const secEl  = document.getElementById('aaSec');\n  const daysWrap = bar.querySelector('[data-unit=\"days\"]');\n\n  const key = 'aa_countdown_end_' + location.pathname;\n  let end = 0;\n\n  if(mode === 'fixed' && bar.dataset.end){\n    end = new Date(bar.dataset.end).getTime();\n  } else {\n    end = parseInt(localStorage.getItem(key) || '0', 10);\n    if(!end || end < Date.now()){\n      end = Date.now() + durationMinutes * 60 * 1000;\n      localStorage.setItem(key, String(end));\n    }\n  }\n\n  function pad(n){ return String(n).padStart(2,'0'); }\n\n  function tick(){\n    let ms = end - Date.now();\n    if(ms <= 0){\n      end = Date.now() + durationMinutes * 60 * 1000;\n      localStorage.setItem(key, String(end));\n      ms = end - Date.now();\n    }\n\n    const totalSec = Math.floor(ms / 1000);\n    const d = Math.floor(totalSec / 86400);\n    const h = Math.floor((totalSec % 86400) / 3600);\n    const m = Math.floor((totalSec % 3600) / 60);\n    const s = totalSec % 60;\n\n    if(daysEl) daysEl.textContent = pad(d);\n    if(hrsEl)  hrsEl.textContent  = pad(h);\n    if(minEl)  minEl.textContent  = pad(m);\n    if(secEl)  secEl.textContent  = pad(s);\n\n    if(daysWrap && hideDaysWhenZero){\n      daysWrap.style.display = d > 0 ? '' : 'none';\n    } else if(daysWrap) {\n      daysWrap.style.display = '';\n    }\n  }\n\n  tick();\n  setInterval(tick, 250);\n})();\n</script>",
