{{ 'tsl-page.css' | asset_url | stylesheet_tag }}
<script src="{{ 'tsl-page.js' | asset_url }}" defer></script>

<div class="tsl tsl-guarantee tsl-reveal" style="background-color: {{ section.settings.bg }};">
  <div class="tsl-guarantee__inner">
    {%- if section.settings.seal != blank -%}
      {{ section.settings.seal | image_url: width: 300 | image_tag:
         loading: 'lazy', class: 'tsl-guarantee__seal', alt: section.settings.heading }}
    {%- endif -%}

    <h2 class="tsl__heading tsl-guarantee__heading">{{ section.settings.heading }}</h2>
    <div class="tsl-guarantee__text">{{ section.settings.text }}</div>

    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link | default: '#tsl-buybox' }}"
         class="tsl__btn"
         {% if section.settings.button_link == blank %}data-tsl-scroll-to-buy{% endif %}>
        {{ section.settings.button_label }}
      </a>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="tsl-guarantee__badges">
        {%- for block in section.blocks -%}
          <div class="tsl-guarantee__badge" {{ block.shopify_attributes }}>
            {% render 'tsl-icon', icon: block.settings.icon %}
            <span>{{ block.settings.label }}</span>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "TSL Guarantee",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "seal", "label": "Seal image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Garantía de Devolución de Dinero de 30 Días" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "AGREGAR AL CARRITO" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Leave blank to scroll to the buy box." },
    { "type": "color", "id": "bg", "label": "Background", "default": "#f8f8f8" }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icon", "default": "shield",
          "options": [
            { "value": "shield", "label": "Shield" },
            { "value": "truck", "label": "Truck" },
            { "value": "refresh", "label": "Returns" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "check-circle", "label": "Check" }
          ]
        },
        { "type": "text", "id": "label", "label": "Label" }
      ]
    }
  ],
  "presets": [{ "name": "TSL Guarantee" }]
}
{% endschema %}
