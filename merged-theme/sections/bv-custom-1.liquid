<!-- ============ SCRIPT: FAQ + FLECHAS CARRUSEL ============ -->
<script>
(function(){
  var root=document.currentScript.closest('.bvn-lp')||document.querySelector('.bvn-lp');
  if(!root)return;
  /* acordeón FAQ */
  root.querySelectorAll('.bvn-faq-q').forEach(function(btn){
    btn.addEventListener('click',function(){
      var item=btn.parentElement;
      var ans=item.querySelector('.bvn-faq-a');
      var open=item.classList.toggle('open');
      ans.style.maxHeight=open?ans.scrollHeight+'px':'0px';
    });
  });
  /* flechas del carrusel */
  var scroller=root.querySelector('.bvn-rev-scroll');
  if(scroller){
    var prev=root.querySelector('.bvn-arrow-prev');
    var next=root.querySelector('.bvn-arrow-next');
    var step=function(){return Math.max(scroller.clientWidth*0.8,240);};
    if(prev)prev.addEventListener('click',function(){scroller.scrollBy({left:-step(),behavior:'smooth'});});
    if(next)next.addEventListener('click',function(){scroller.scrollBy({left:step(),behavior:'smooth'});});
  }
})();
</script>

