  document.addEventListener("DOMContentLoaded", function () {
	// One time and sub button toggle
	const oneOfferButton = document.querySelector(".oneOfferButton");
	const subOfferButton = document.querySelector(".subOfferButton");
	const oneOfferWrap = document.querySelector(".khOneOffer");
	const subOfferWrap = document.querySelector(".khSubOffer");
	const subDetailsBox = document.querySelector(".subDetailsBox");
	const subDetails = document.querySelectorAll(".subDetails");
	if (!oneOfferButton || !subOfferButton || !oneOfferWrap || !subOfferWrap) return;
	let selectedOfferIndex = 1;
	// Default: page load e 2nd offer selected thakbe, jodi sessionStorage e valid data na thake
	function setActiveOfferButton(clickedButton) {
	  oneOfferButton.classList.remove("activeOfferType");
	  subOfferButton.classList.remove("activeOfferType");
	  clickedButton.classList.add("activeOfferType");
	}
	function getOfferValueByIndex(index) {
	  const offerValues = ["b1g1", "b2g2", "b3g3"];
	  return offerValues[index] || "b2g2";
	}
	function getIndexByOfferValue(offerValue) {
	  const offerValues = ["b1g1", "b2g2", "b3g3"];
	  const index = offerValues.indexOf(offerValue);
	  return index !== -1 ? index : 1;
	}
	function getStoredOfferState() {
	  const storedOffer = sessionStorage.getItem("khOffer");
	  if (!storedOffer) {
		return {
		  type: "sub",
		  index: 1
		};
	  }
	  const offerParts = storedOffer.split("_");
	  const offerValue = offerParts[0];
	  const offerType = offerParts[1];
	  return {
		type: offerType === "ot" ? "one" : "sub",
		index: getIndexByOfferValue(offerValue)
	  };
	}
	function updateSessionStorage(offerType) {
	  const offerValue = getOfferValueByIndex(selectedOfferIndex);
	  sessionStorage.setItem("khOffer", offerValue + "_" + offerType);
	}
	function setActiveBoxByIndex(selectedIndex) {
	  const allGroups = [subOfferWrap, oneOfferWrap];
	  allGroups.forEach((offerWrap) => {
		const boxes = offerWrap.querySelectorAll(".khOfferBox");
		boxes.forEach((box, index) => {
		  box.classList.remove("of_selected_box");
		  if (index === selectedIndex) {
			box.classList.add("of_selected_box");
		  }
		}
					 );
	  }
					   );
	}
	function updateSubDetails(isSubActive) {
	  if (!subDetailsBox) return;
	  if (!isSubActive) {
		subDetailsBox.style.display = "none";
		return;
	  }
	  subDetailsBox.style.display = "block";
	  subDetails.forEach((detail, index) => {
		detail.style.display = index === selectedOfferIndex ? "block" : "none";
	  }
						);
	}
	function showOfferType(type) {
	  if (type === "sub") {
		subOfferWrap.style.display = "flex";
		oneOfferWrap.style.display = "none";
		setActiveOfferButton(subOfferButton);
		setActiveBoxByIndex(selectedOfferIndex);
		updateSubDetails(true);
		updateSessionStorage("sub");
	  }
	  if (type === "one") {
		subOfferWrap.style.display = "none";
		oneOfferWrap.style.display = "flex";
		setActiveOfferButton(oneOfferButton);
		setActiveBoxByIndex(selectedOfferIndex);
		updateSubDetails(false);
		updateSessionStorage("ot");
	  }
	}
	function restoreOfferFromSessionStorage() {
	  const storedState = getStoredOfferState();
	  selectedOfferIndex = storedState.index;
	  showOfferType(storedState.type);
	}
	// On page load / restore selected offer
	restoreOfferFromSessionStorage();
	// Browser back/forward cache restore support
	window.addEventListener("pageshow", function () {
	  restoreOfferFromSessionStorage();
	}
						   );
	// Offer type click handlers
	oneOfferButton.addEventListener("click", function () {
	  showOfferType("one");
	}
								   );
	subOfferButton.addEventListener("click", function () {
	  showOfferType("sub");
	}
								   );
	// Offer box active code
	[subOfferWrap, oneOfferWrap].forEach((offerWrap) => {
	  const boxes = offerWrap.querySelectorAll(".khOfferBox");
	  boxes.forEach((box, index) => {
		box.addEventListener("click", function () {
		  selectedOfferIndex = index;
		  setActiveBoxByIndex(selectedOfferIndex);
		  if (subOfferButton.classList.contains("activeOfferType")) {
			updateSubDetails(true);
			updateSessionStorage("sub");
		  }
		  else {
			updateSessionStorage("ot");
		  }
		}
							);
	  }
				   );
	}
										);
  }
						   );
