<div class="page-width" style="max-width: 1100px; margin: 0 auto; padding: 3rem 1.5rem;">
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2.5rem; align-items: start;">
    <div>
      {%- if product.featured_image -%}
        <img
          src="{{ product.featured_image | image_url: width: 900 }}"
          alt="{{ product.featured_image.alt | escape }}"
          width="900"
          height="{{ 900 | divided_by: product.featured_image.aspect_ratio | round }}"
          style="width: 100%; height: auto; border-radius: 12px;"
          loading="eager"
        >
      {%- endif -%}
    </div>

    <div>
      <h1 style="margin: 0 0 0.5rem;">{{ product.title }}</h1>

      <p style="font-size: 1.5rem; margin: 0 0 1.5rem;">
        {{ product.selected_or_first_available_variant.price | money }}
        {%- if product.compare_at_price > product.price %}
          <s style="opacity: .6; font-size: 1rem;">{{ product.compare_at_price | money }}</s>
        {%- endif -%}
      </p>

      {%- form 'product', product -%}
        {%- if product.variants.size > 1 -%}
          <label for="variant-select" style="display: block; margin-bottom: .5rem;">
            {{ product.options_with_values.first.name }}
          </label>
          <select id="variant-select" name="id" style="width: 100%; padding: .75rem; margin-bottom: 1rem;">
            {%- for variant in product.variants -%}
              <option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>
                {{ variant.title }} &ndash; {{ variant.price | money }}
              </option>
            {%- endfor -%}
          </select>
        {%- else -%}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        {%- endif -%}

        <input type="number" name="quantity" value="1" min="1" style="width: 100%; padding: .75rem; margin-bottom: 1rem;">

        <button
          type="submit"
          name="add"
          style="width: 100%; padding: 1rem; font-size: 1rem; cursor: pointer; border: 0; border-radius: 8px; background: #2bb2fd; color: #fff;"
          {% unless product.available %}disabled{% endunless %}
        >
          {%- if product.available -%}{{ 'products.product.add_to_cart' | t }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
        </button>
      {%- endform -%}

      <div class="rte" style="margin-top: 2rem;">{{ product.description }}</div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Product",
  "settings": []
}
{% endschema %}