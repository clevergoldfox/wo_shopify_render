{%- comment -%}
  "You May Also Like", ported from the reference store's own theme section.
  Self-contained: its CSS and JS are inline, no external assets.

  The reference hardcodes its own products. Here the carousel is filled from this
  store's catalogue -- the product's own collection, minus the product itself.
{%- endcomment -%}
{%- assign rel_source = product.collections.first -%}
{%- unless rel_source -%}
  {%- assign rel_source = collections.all -%}
{%- endunless -%}
{%- if rel_source.products.size > 1 -%}



  <section
    id="mi-selectable-related-{{ section.id }}"
    class="mi-related-products-section color-scheme-1"
    data-mi-related-section
    style="
      --mi-rp-heading-color: #005624;
      --mi-rp-text-color: #005624;
      --mi-rp-price-color: #005624;
      --mi-rp-compare-color: #6f9279;
      --mi-rp-sale-bg: #75a843;
      --mi-rp-sale-color: #ffffff;
      --mi-rp-sale-top: 0px;
      --mi-rp-sale-left: 0px;
      --mi-rp-progress-color: #005624;
      --mi-rp-progress-bg: #edf3ee;
      --mi-rp-card-bg: #ffffff;
      --mi-rp-image-bg: #ffffff;
      --mi-rp-add-bg: #75a843;
      --mi-rp-add-color: #ffffff;
      --mi-rp-add-width-desktop: 120px;
      --mi-rp-add-width-mobile: 125px;
      --mi-rp-add-height-desktop: 54px;
      --mi-rp-add-height-mobile: 58px;
      --mi-rp-add-font-desktop: 19px;
      --mi-rp-add-font-mobile: 20px;
      --mi-rp-add-radius: 48px;
      --mi-rp-top-padding: 30px;
      --mi-rp-bottom-padding: 40px;
      --mi-rp-heading-size-desktop: 30px;
      --mi-rp-heading-size-mobile: 22px;
      --mi-rp-columns-desktop: 5;
      --mi-rp-columns-mobile: 2;
      --mi-rp-gap: 24px;
      --mi-rp-image-radius: 0px;
      --mi-rp-card-radius: 0px;
      --mi-rp-title-size: 18px;
      --mi-rp-price-size: 19px;
    "
  >
    <div class="page-width">
      
        <div class="mi-related-products-header mi-related-products-header--center">
          

          
            <h2 class="mi-related-products-heading">
              You May Also Like
            </h2>
          

          
        </div>
      

      
        <div class="mi-related-products-shell">
          <div class="mi-related-products-track" data-mi-related-track>
            
              

              {%- assign rel_shown = 0 -%}
{%- for p in rel_source.products -%}
  {%- if p.id == product.id -%}{%- continue -%}{%- endif -%}
  {%- unless p.featured_image -%}{%- continue -%}{%- endunless -%}
{%- if p.handle contains 'example-product' -%}{%- continue -%}{%- endif -%}
  {%- if rel_shown >= 8 -%}{%- break -%}{%- endif -%}
  {%- assign rel_shown = rel_shown | plus: 1 -%}
              <article class="mi-related-product-card" data-mi-related-card>
                <a class="mi-related-product-image-link" href="{{ p.url }}" aria-label="{{ p.title | escape }}">
                  <div class="mi-related-product-image-wrap mi-related-product-image-wrap--square">
                    {%- if p.compare_at_price > p.price -%}
                      <span class="mi-related-product-sale-badge">
                        Sale
                      </span>
                    {%- endif -%}
                    {%- if p.featured_image -%}
                      <img src="{{ p.featured_image | image_url: width: 900 }}" alt="{{ p.title | escape }}" srcset="{{ p.featured_image | image_url: width: 352 }} 352w, {{ p.featured_image | image_url: width: 832 }} 832w, {{ p.featured_image | image_url: width: 900 }} 900w" width="900" height="900" loading="lazy" class="mi-related-product-image">
                    {%- endif -%}
                  </div>
                </a>

                <div class="mi-related-product-info">
                  <a class="mi-related-product-title" href="{{ p.url }}">
                    {{ p.title }}
                  </a>

                  <div class="mi-related-product-price-row">
                    <span class="mi-related-product-price">
                      {%- if p.price_varies -%}From {{ p.price_min | money }}{%- else -%}{{ p.price | money }}{%- endif -%}
                    </span>

                    {%- if p.compare_at_price > p.price -%}
                      <span class="mi-related-product-compare">
                        {{ p.compare_at_price | money }}
                      </span>
                    {%- endif -%}
                  </div>
                </div>
              </article>
            {%- endfor -%}
            
              
          </div>

          
            <div class="mi-related-products-progress" aria-hidden="true">
              <span data-mi-related-progress></span>
            </div>
          
        </div>
      
    </div>

    <style>
      #mi-selectable-related-{{ section.id }} {
        padding-top: var(--mi-rp-top-padding);
        padding-bottom: var(--mi-rp-bottom-padding);
        color: var(--mi-rp-text-color);
        overflow: hidden;
      }

      #mi-selectable-related-{{ section.id }} .mi-related-products-full {
        width: 100%;
        padding-left: 4rem;
        padding-right: 4rem;
      }

      #mi-selectable-related-{{ section.id }} .mi-related-products-header {
        margin-bottom: 42px;
      }

      #mi-selectable-related-{{ section.id }} .mi-related-products-header--left {
        text-align: left;
      }

      #mi-selectable-related-{{ section.id }} .mi-related-products-header--center {
        text-align: center;
      }

      #mi-selectable-related-{{ section.id }} .mi-related-products-header--right {
        text-align: right;
      }

      #mi-selectable-related-{{ section.id }} .mi-related-products-subheading {
        margin-bottom: 10px;
        color: var(--mi-rp-text-color);
        font-size: 15px;
        line-height: 1.4;
      }

      #mi-selectable-related-{{ section.id }} .mi-related-products-heading {
        margin: 0;
        color: var(--mi-rp-heading-color);
        font-size: var(--mi-rp-heading-size-desktop);
        line-height: 1.08;
        font-weight: 800;
        letter-spacing: -0.03em;
      }

      #mi-selectable-related-{{ section.id }} .mi-related-products-text {
        max-width: 760px;
        margin: 14px auto 0;
        color: var(--mi-rp-text-color);
        font-size: 16px;
        line-height: 1.55;
      }

      #mi-selectable-related-{{ section.id }} .mi-related-products-header--left .mi-related-products-text {
        margin-left: 0;
      }

      #mi-selectable-related-{{ section.id }} .mi-related-products-header--right .mi-related-products-text {
        margin-right: 0;
      }

      #mi-selectable-related-{{ section.id }} .mi-related-products-shell {
        position: relative;
      }

      #mi-selectable-related-{{ section.id }} .mi-related-products-track {
        display: grid;
        grid-auto-flow: column;
        grid-auto-columns: calc((100% - (var(--mi-rp-gap) * (var(--mi-rp-columns-desktop) - 1))) / var(--mi-rp-columns-desktop));
        gap: var(--mi-rp-gap);
        overflow-x: auto;
        overflow-y: hidden;
        scroll-snap-type: x proximity;
        scroll-behavior: smooth;
        scrollbar-width: none;
        padding-bottom: 22px;
      }

      #mi-selectable-related-{{ section.id }} .mi-related-products-track::-webkit-scrollbar {
        display: none;
      }

      #mi-selectable-related-{{ section.id }} .mi-related-product-card {
        min-width: 0;
        scroll-snap-align: start;
        background: var(--mi-rp-card-bg);
        border-radius: var(--mi-rp-card-radius);
      }

      #mi-selectable-related-{{ section.id }} .mi-related-product-image-link,
      #mi-selectable-related-{{ section.id }} .mi-related-product-title {
        color: inherit;
        text-decoration: none;
      }

      #mi-selectable-related-{{ section.id }} .mi-related-product-image-wrap {
        position: relative;
        width: 100%;
        background: var(--mi-rp-image-bg);
        border-radius: var(--mi-rp-image-radius);
        overflow: visible;
      }

      #mi-selectable-related-{{ section.id }} .mi-related-product-image-wrap--square {
        aspect-ratio: 1 / 1;
      }

      #mi-selectable-related-{{ section.id }} .mi-related-product-image-wrap--portrait {
        aspect-ratio: 4 / 5;
      }

      #mi-selectable-related-{{ section.id }} .mi-related-product-image-wrap--adapt {
        aspect-ratio: 1 / 1;
      }

      #mi-selectable-related-{{ section.id }} .mi-related-product-image {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: contain;
        transition: transform 0.25s ease;
      }

      #mi-selectable-related-{{ section.id }} .mi-related-product-card:hover .mi-related-product-image {
        transform: scale(1.03);
      }

      #mi-selectable-related-{{ section.id }} .mi-related-product-placeholder {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      #mi-selectable-related-{{ section.id }} .mi-related-product-placeholder svg {
        width: 70%;
        height: 70%;
      }

      #mi-selectable-related-{{ section.id }} .mi-related-product-sale-badge {
        position: absolute;
        top: var(--mi-rp-sale-top);
        left: var(--mi-rp-sale-left);
        z-index: 3;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 30px;
        padding: 5px 12px;
        border-radius: 999px;
        background: var(--mi-rp-sale-bg);
        color: var(--mi-rp-sale-color);
        font-size: 14px;
        line-height: 1;
        font-weight: 800;
      }

      #mi-selectable-related-{{ section.id }} .mi-related-product-info {
        padding-top: 18px;
      }

      #mi-selectable-related-{{ section.id }} .mi-related-product-title {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        color: var(--mi-rp-text-color);
        font-size: var(--mi-rp-title-size);
        line-height: 1.35;
        font-weight: 700;
      }

      #mi-selectable-related-{{ section.id }} .mi-related-product-price-row {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 8px;
        margin-top: 10px;
      }

      #mi-selectable-related-{{ section.id }} .mi-related-product-price {
        color: var(--mi-rp-price-color);
        font-size: var(--mi-rp-price-size);
        line-height: 1.2;
        font-weight: 800;
      }

      #mi-selectable-related-{{ section.id }} .mi-related-product-compare {
        color: var(--mi-rp-compare-color);
        font-size: calc(var(--mi-rp-price-size) * 0.86);
        line-height: 1.2;
        font-weight: 600;
        text-decoration: line-through;
      }

      #mi-selectable-related-{{ section.id }} .mi-related-product-add {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: var(--mi-rp-add-width-desktop);
        max-width: 100%;
        height: var(--mi-rp-add-height-desktop);
        min-height: 0;
        margin-top: 18px;
        padding: 0 18px;
        border: 0;
        border-radius: var(--mi-rp-add-radius);
        background: var(--mi-rp-add-bg);
        color: var(--mi-rp-add-color);
        font-size: var(--mi-rp-add-font-desktop);
        line-height: 1;
        font-weight: 900;
        letter-spacing: 0.12em;
        cursor: pointer;
        text-transform: uppercase;
        transition: opacity 0.2s ease, transform 0.2s ease;
      }

      #mi-selectable-related-{{ section.id }} .mi-related-product-add:hover {
        transform: translateY(-1px);
      }

      #mi-selectable-related-{{ section.id }} .mi-related-product-add:disabled {
        opacity: 0.55;
        cursor: not-allowed;
        transform: none;
      }

      #mi-selectable-related-{{ section.id }} .mi-related-products-progress {
        position: relative;
        width: 100%;
        max-width: 980px;
        height: 4px;
        margin-top: 10px;
        background: var(--mi-rp-progress-bg);
        overflow: hidden;
      }

      #mi-selectable-related-{{ section.id }} .mi-related-products-progress span {
        position: absolute;
        top: 0;
        left: 0;
        display: block;
        width: 20%;
        height: 100%;
        background: var(--mi-rp-progress-color);
        transform: translateX(0);
        transition: transform 0.12s ease, width 0.12s ease;
      }

      #mi-selectable-related-{{ section.id }} .mi-related-products-empty {
        padding: 32px;
        border: 1px dashed rgba(0, 0, 0, 0.2);
        text-align: center;
      }

      

      @media screen and (max-width: 749px) {
        #mi-selectable-related-{{ section.id }} {
          padding-top: calc(var(--mi-rp-top-padding) * 0.75);
          padding-bottom: calc(var(--mi-rp-bottom-padding) * 0.75);
        }

        #mi-selectable-related-{{ section.id }} .mi-related-products-full {
          padding-left: 16px;
          padding-right: 16px;
        }

        #mi-selectable-related-{{ section.id }} .mi-related-products-header {
          margin-bottom: 28px;
        }

        #mi-selectable-related-{{ section.id }} .mi-related-products-heading {
          font-size: var(--mi-rp-heading-size-mobile);
        }

        #mi-selectable-related-{{ section.id }} .mi-related-products-track {
          grid-auto-columns: calc((100% - (var(--mi-rp-gap) * (var(--mi-rp-columns-mobile) - 1))) / var(--mi-rp-columns-mobile));
          padding-bottom: 18px;
        }

        

        #mi-selectable-related-{{ section.id }} .mi-related-product-info {
          padding-top: 12px;
        }

        #mi-selectable-related-{{ section.id }} .mi-related-product-title {
          font-size: calc(var(--mi-rp-title-size) * 0.9);
        }

        #mi-selectable-related-{{ section.id }} .mi-related-product-price {
          font-size: calc(var(--mi-rp-price-size) * 0.9);
        }

        #mi-selectable-related-{{ section.id }} .mi-related-product-add {
          width: var(--mi-rp-add-width-mobile);
          height: var(--mi-rp-add-height-mobile);
          font-size: var(--mi-rp-add-font-mobile);
          margin-top: 16px;
        }

        #mi-selectable-related-{{ section.id }} .mi-related-products-progress {
          width: 100%;
          margin-top: 8px;
        }
      }
    </style>

    <script>
      (() => {
        const section = document.getElementById('mi-selectable-related-{{ section.id }}');
        if (!section) return;

        const track = section.querySelector('[data-mi-related-track]');
        const progress = section.querySelector('[data-mi-related-progress]');
        const addButtons = Array.from(section.querySelectorAll('[data-mi-related-add]'));

        const root =
          window.Shopify && window.Shopify.routes && window.Shopify.routes.root
            ? window.Shopify.routes.root
            : '/';

        const updateProgress = () => {
          if (!track || !progress) return;

          const scrollWidth = track.scrollWidth;
          const clientWidth = track.clientWidth;
          const maxScroll = Math.max(0, scrollWidth - clientWidth);

          if (maxScroll <= 2) {
            progress.style.width = '100%';
            progress.style.transform = 'translateX(0px)';
            return;
          }

          const visibleRatio = Math.max(0.12, Math.min(1, clientWidth / scrollWidth));
          const thumbWidth = visibleRatio * 100;
          const movePercent = (track.scrollLeft / maxScroll) * (100 - thumbWidth);

          progress.style.width = thumbWidth + '%';
          progress.style.transform = 'translateX(' + movePercent + '%)';
        };

        const refreshAndOpenCartDrawer = async () => {
          document.dispatchEvent(
            new CustomEvent('cart:refresh', {
              bubbles: true,
              detail: {
                open: true
              }
            })
          );

          try {
            const cartResponse = await fetch(root + 'cart.js', {
              method: 'GET',
              headers: {
                Accept: 'application/json'
              }
            });

            const cart = await cartResponse.json();

            document.dispatchEvent(
              new CustomEvent('cart:updated', {
                bubbles: true,
                detail: {
                  cart: cart
                }
              })
            );

            document.dispatchEvent(
              new CustomEvent('cart:change', {
                bubbles: true,
                detail: {
                  cart: cart
                }
              })
            );
          } catch (error) {
            console.warn('MI Related Products cart update failed:', error);
          }
        };

        const addToCart = async (button) => {
          if (!button || button.disabled) return;

          const variantId = Number(button.dataset.variantId);
          const text = button.querySelector('[data-mi-related-add-text]');
          const originalText = text ? text.textContent : '';

          if (!variantId) return;

          button.disabled = true;

          if (text) {
            text.textContent = 'ADDING';
          }

          try {
            const response = await fetch(root + 'cart/add.js', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                Accept: 'application/json'
              },
              body: JSON.stringify({
                id: variantId,
                quantity: 1
              })
            });

            if (!response.ok) {
              throw new Error('Add to cart failed');
            }

            await response.json();

            if (text) {
              text.textContent = 'ADDED';
            }

            await refreshAndOpenCartDrawer();

            setTimeout(() => {
              button.disabled = false;
              if (text) {
                text.textContent = originalText.trim() || 'ADD';
              }
            }, 1200);
          } catch (error) {
            console.error(error);

            if (text) {
              text.textContent = 'ERROR';
            }

            setTimeout(() => {
              button.disabled = false;
              if (text) {
                text.textContent = originalText.trim() || 'ADD';
              }
            }, 1500);
          }
        };

        if (track) {
          track.addEventListener('scroll', updateProgress, { passive: true });
          window.addEventListener('resize', updateProgress);
          setTimeout(updateProgress, 80);
          setTimeout(updateProgress, 500);
          setTimeout(updateProgress, 1200);
        }

        addButtons.forEach((button) => {
          button.addEventListener('click', () => addToCart(button));
        });
      })();
    </script>
  </section>




{%- endif -%}

{% schema %}
{
  "name": "Col Related",
  "class": "section-mi-related-products col-scope",
  "settings": []
}
{% endschema %}
