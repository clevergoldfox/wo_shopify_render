<script>
  (function() {
    class AnnouncementBaradvjtc2llzuvsl0thkaigenblock55fa630qmtkhu extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 0;
        this.slides = [];
        this.rotationInterval = null;
      }

      connectedCallback() {
        this.slides = Array.from(this.querySelectorAll('.ai-announcement-bar__slide-advjtc2llzuvsl0thkaigenblock55fa630qmtkhu'));
        
        if (this.slides.length === 0) return;

        this.currentSlide = 0;
        this.slides[0].classList.add('active');

        const autoRotate = this.dataset.autoRotate === 'true';
        const rotationSpeed = parseInt(this.dataset.rotationSpeed) * 1000;

        if (autoRotate && this.slides.length > 1) {
          this.startRotation(rotationSpeed);
        }
      }

      startRotation(speed) {
        this.rotationInterval = setInterval(() => {
          this.nextSlide();
        }, speed);
      }

      nextSlide() {
        const currentSlideElement = this.slides[this.currentSlide];
        currentSlideElement.classList.add('exit');
        currentSlideElement.classList.remove('active');

        this.currentSlide = (this.currentSlide + 1) % this.slides.length;
        const nextSlideElement = this.slides[this.currentSlide];

        setTimeout(() => {
          currentSlideElement.classList.remove('exit');
          nextSlideElement.classList.add('active');
        }, 100);
      }

      disconnectedCallback() {
        if (this.rotationInterval) {
          clearInterval(this.rotationInterval);
        }
      }
    }

    customElements.define('announcement-bar-advjtc2llzuvsl0thkaigenblock55fa630qmtkhu', AnnouncementBaradvjtc2llzuvsl0thkaigenblock55fa630qmtkhu);
  })();
</script>

