<script>
    (function () {
        "use strict";

        function qs(selector, root) {
            return (root || document).querySelector(selector);
        }

        function injectProductRatingFallback() {
            var anchor = qs(".areviews_header_stars");

            if (!anchor) return;

            var hasMetafieldRating = anchor.getAttribute("data-areviews-has-metafield") === "1";
            var hasDesignMetafield = anchor.getAttribute("data-areviews-has-design-metafield") === "1";
            var showTopTitleRating = anchor.getAttribute("data-areviews-show-top-title-rating") === "1";
            var hasRatingBreakdown = anchor.getAttribute("data-areviews-has-rating-breakdown") === "1";
            var needsHoverFallback = showTopTitleRating && !hasRatingBreakdown;

            if (hasMetafieldRating && hasDesignMetafield && !needsHoverFallback && anchor.innerHTML.trim() !== "") {
                return;
            }

            var productRatingEl = qs(".Products_reviews");
            if (!productRatingEl) return;

            var productRatingHtml = productRatingEl.innerHTML || "";
            if (!productRatingHtml.trim()) return;

            var html =
                '<div style="text-decoration: none!important;" class="areviews_main_header_container areviews_from_app">' +
                productRatingHtml +
                "</div>";

            anchor.innerHTML = html;

            var average = productRatingEl.getAttribute("data-areviews-average");
            var count = productRatingEl.getAttribute("data-areviews-count");
            if (average !== null) anchor.setAttribute("data-areviews-average", average);
            if (count !== null) anchor.setAttribute("data-areviews-count", count);
            anchor.setAttribute("data-areviews-render-source", "app");
        }

        injectProductRatingFallback();
    })();
</script>




<style>
    .areviews_tooltip_portal {
        position: fixed !important;
        top: 0;
        left: 0;
