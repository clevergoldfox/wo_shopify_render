<script>
    (function () {
        "use strict";

        // The merchant can add this app block to the product page more than once
        // (or the theme may call it from several sections). Every instance renders
        // the same metafield rating, so only the FIRST one may stay visible.
        // Each block instance runs its own copy of this script while the page is
        // still parsing, so at this point the DOM contains this instance and every
        // instance before it — hide everything after the first.
        var all = document.querySelectorAll(".areviews_header_stars");
        for (var i = 1; i < all.length; i++) {
            all[i].style.display = "none";
        }

        // ------------------------------------------------------------------
        // Rating dedupe. Two renders of the product-title rating can land on
        // the page at once: this block (and the fresh areviews_app.js) render or
        // rebuild it INSIDE <div class="areviews_header_stars">, while an OLD
        // cached areviews_app.js on the same shop inserts a second
        // .areviews_main_header_container as a sibling just BELOW it (and, in
        // some older versions, ABOVE it — right after the product title).
        //
        // Strategy: keep the container that lives INSIDE .areviews_header_stars —
        // the canonical, styled one this block controls — and remove every other
        // .areviews_main_header_container, wherever the old code placed it (below
        // or above). Pinning the keeper this way (instead of "keep the first in
        // the DOM") is what makes the below-AND-above cases both safe. When there
        // is no .areviews_header_stars on the page at all, fall back to the first.
        //
        // The hidden rating inside the reviews section (#az_reviews) — the copy we
        // render there on purpose so the app can read the numbers without a second
        // AJAX call — is a DATA SOURCE, not a visible duplicate, so it (and any
        // .Products_reviews source markup) is always excluded.
        // ------------------------------------------------------------------
        function dedupeTitleRating() {
            var az = document.getElementById('az_reviews');

            var containers = document.querySelectorAll('.areviews_main_header_container');
            var visible = [];
            for (var i = 0; i < containers.length; i++) {
                if (az && az.contains(containers[i])) continue;
                if (containers[i].closest && containers[i].closest('.Products_reviews')) continue;
                visible.push(containers[i]);
            }

            // The keeper is the container inside the first .areviews_header_stars,
            // so a stale duplicate is removed whether it was inserted below or above.
            var headerStars = document.querySelector('.areviews_header_stars');
            var keeper = null;
            if (headerStars) {
                for (var k = 0; k < visible.length; k++) {
                    if (headerStars.contains(visible[k])) { keeper = visible[k]; break; }
                }
            }
            if (!keeper) keeper = visible[0];

            for (var j = 0; j < visible.length; j++) {
                var node = visible[j];
                if (!keeper || node === keeper) continue;
                // Never remove the keeper's own wrapper/ancestor or a child of it.
                if (node.contains(keeper) || keeper.contains(node)) continue;
                // Take an old <a href="#"> wrapper along with the duplicate.
                var wrapper = node.closest ? node.closest('a[href="#"]') : null;
                if (wrapper && !wrapper.contains(keeper)) node = wrapper;
                if (node.parentNode) node.parentNode.removeChild(node);
            }
        }

        // Register once even when this block is placed on the page multiple
        // times (each instance runs its own copy of this script). Old code
        // injects its duplicate only after its AJAX finishes, so watch the DOM.
        if (!window.__areviewsRatingDedupe) {
            window.__areviewsRatingDedupe = true;
            if (window.MutationObserver) {
                new MutationObserver(dedupeTitleRating).observe(document.body || document.documentElement, { childList: true, subtree: true });
            }
            dedupeTitleRating();
        }
    })();
</script>

