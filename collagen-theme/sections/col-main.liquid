<script>
    (function () {
        "use strict";

        // Global guard: the block can be placed on the page more than once —
        // only the first copy of this snippet runs.
        if (window.__areviewsTooltipPortal) return;
        window.__areviewsTooltipPortal = true;

        var OPEN_CLASS = "areviews_tooltip_open";
        var ABOVE_CLASS = "areviews_tooltip_above";
        var portal = null;
        var currentHost = null;
        var hideTimer = null;

        function ensurePortal() {
            if (portal && portal.parentNode) return portal;
            portal = document.createElement("div");
            portal.className = "areviews_tooltip_portal areviewstooltip";
            portal.addEventListener("mouseenter", cancelHide);
            portal.addEventListener("mouseleave", scheduleHide);
            (document.body || document.documentElement).appendChild(portal);
            return portal;
        }

        function cancelHide() {
            if (hideTimer) {
                clearTimeout(hideTimer);
                hideTimer = null;
            }
        }

        // Grace delay so the pointer can travel from the stars into the
        // tooltip (they are separate DOM branches once portaled).
        function scheduleHide() {
            cancelHide();
            hideTimer = setTimeout(closeTooltip, 200);
        }

        function closeTooltip() {
            cancelHide();
            if (portal) portal.classList.remove(OPEN_CLASS);
            currentHost = null;
        }

        function positionPortal(host) {
            if (!portal) return;
            // Theme re-rendered the product info (variant change) — bail out.
            if (!document.documentElement.contains(host)) {
                closeTooltip();
                return;
            }

            var rect = host.getBoundingClientRect();
            var vw = window.innerWidth || document.documentElement.clientWidth;
            var vh = window.innerHeight || document.documentElement.clientHeight;
            var pw = portal.offsetWidth;
            var ph = portal.offsetHeight;

            var left = Math.round(rect.left + rect.width / 2 - pw / 2);
            left = Math.max(8, Math.min(left, vw - pw - 8));

            var top = Math.round(rect.bottom + 10);
            var above = false;
            if (top + ph > vh - 8 && rect.top - ph - 10 >= 8) {
                top = Math.round(rect.top - ph - 10);
                above = true;
            }

            var arrowX = Math.round(rect.left + rect.width / 2 - left);
            arrowX = Math.max(14, Math.min(arrowX, pw - 14));

            portal.style.top = top + "px";
            portal.style.left = left + "px";
            portal.style.setProperty("--areviews-arrow-x", arrowX + "px");
            portal.classList.toggle(ABOVE_CLASS, above);
        }

        function openTooltip(host) {
            cancelHide();
            if (currentHost === host && portal && portal.classList.contains(OPEN_CLASS)) {
                positionPortal(host);
                return;
            }

            // The tip may already live in the portal from a previous hover of
            // the same host — host.__areviewsTipNode remembers it.
            var tip = host.__areviewsTipNode && portal && portal.contains(host.__areviewsTipNode)
                ? host.__areviewsTipNode
                : host.querySelector(".areviewstooltiptext");
            if (!tip) return;

            var p = ensurePortal();
            if (tip.parentNode !== p) {
                while (p.firstChild) p.removeChild(p.firstChild);
                p.appendChild(tip);
            }
            host.__areviewsTipNode = tip;
            currentHost = host;
            p.classList.add(OPEN_CLASS);
            positionPortal(host);
            positionPortal(host); // second pass once the final size is known
        }

        document.addEventListener("mouseover", function (e) {
            if (!e.target || !e.target.closest) return;
            // Hovering the portal itself keeps it open (checked FIRST — the
            // portal carries the areviewstooltip class too).
            if (portal && portal.contains(e.target)) {
                cancelHide();
                return;
            }
            var host = e.target.closest(".areviewstooltip");
            if (host) {
                openTooltip(host);
                return;
            }
            if (currentHost) scheduleHide();
        }, true);

        // Pointer left the window entirely.
        document.addEventListener("mouseout", function (e) {
            if (!e.relatedTarget && currentHost) scheduleHide();
        }, true);

        // Capture-phase scroll so scrollable theme containers reposition the
        // tooltip too, not just the window.
        window.addEventListener("scroll", function () {
            if (currentHost) positionPortal(currentHost);
        }, true);

        window.addEventListener("resize", function () {
            if (currentHost) positionPortal(currentHost);
        });
    })();
</script>





