<style>
  /*
    WK version 17 - keep native Shop Pay terms and linked shipping text even when Price block is hidden
    Reference order: badge -> brand/title -> reviews -> variant buttons -> subscription module.
    Main fix:
    1. Hide only the top price number, not the whole price block.
    2. Keep the original Shopify shipping + Shop Pay installment component and move it below the purple Shop Pay button.
    3. Hide the variant label line, e.g. "Size: 120 Softgels".
    4. Only control spacing around title / review / variant / subscription.
    5. Do not use broad div/span hiding, so the product page will not disappear.
  */

  product-info {
    --wk-title-review-gap: 10px;
    --wk-review-variant-gap: 14px;
    --wk-variant-subscription-gap: 26px;
  }

  /*
    Hide only the top price number, NOT the whole price block.
    Important: shipping text and Shop Pay installment text often live inside the same price block.
    If we hide the whole block, those lines disappear too.
  */
  product-info .wk-hide-top-price-block {
    margin-top: 0 !important;
    margin-bottom: 0 !important;
    padding-top: 0 !important;
    padding-bottom: 0 !important;
    min-height: 0 !important;
  }

  product-info .wk-hide-top-price-block .price,
  product-info .wk-hide-top-price-block .product__price,
  product-info .wk-hide-top-price-block [data-price],
  product-info .wk-hide-top-price-block [class*="product-price"],
  product-info .wk-hide-top-price-block .price__container,
  product-info .wk-hide-top-price-block .price-item,
  product-info .wk-hide-top-price-block .money {
    display: none !important;
  }

  product-info .wk-hide-top-price-block .product__tax,
  product-info .wk-hide-top-price-block .product__policies,
  product-info .wk-hide-top-price-block shopify-payment-terms,
  product-info .wk-hide-top-price-block .shopify-payment-terms {
    display: block !important;
  }

  /* Title block: keep normal title layout, only set the gap below it. */
  product-info .wk-title-block-clean {
    margin-bottom: var(--wk-title-review-gap) !important;
    padding-bottom: 0 !important;
  }

  product-info .wk-title-block-clean > *:last-child {
    margin-bottom: 0 !important;
    padding-bottom: 0 !important;
  }

  /* Review block: set only the gap below reviews. */
  product-info .wk-review-block-clean {
    margin-top: 0 !important;
    margin-bottom: var(--wk-review-variant-gap) !important;
    padding-top: 0 !important;
    padding-bottom: 0 !important;
  }

  product-info .wk-review-block-clean .jdgm-widget,
  product-info .wk-review-block-clean .jdgm-prev-badge,
  product-info .wk-review-block-clean .product__rating,
  product-info .wk-review-block-clean .rating,
  product-info .wk-review-block-clean [class*="rating"] {
    margin-top: 0 !important;
    margin-bottom: 0 !important;
    padding-top: 0 !important;
    padding-bottom: 0 !important;
  }

  /* Keep only the review area's vertical spacing controlled, without touching other blocks. */
  product-info .wk-title-block-clean + .wk-review-block-clean {
    margin-top: 0 !important;
  }

  product-info .wk-review-block-clean + .wk-variant-block-clean {
    margin-top: 0 !important;
  }

  product-info .wk-review-block-clean > * {
    margin-top: 0 !important;
    margin-bottom: 0 !important;
  }

  /* Variant block: remove label, keep a clean gap below before subscription. */
  product-info .wk-variant-block-clean {
    margin-top: 0 !important;
    margin-bottom: var(--wk-variant-subscription-gap) !important;
    padding-top: 0 !important;
  }

  product-info .wk-variant-block-clean > *,
  product-info .wk-variant-block-clean .product-form__input,
  product-info .wk-variant-block-clean variant-radios,
  product-info .wk-variant-block-clean variant-selects,
  product-info .wk-variant-block-clean .variant-picker,
  product-info .wk-variant-block-clean .product__variant-picker {
    margin-top: 0 !important;
    padding-top: 0 !important;
  }

  /* Hide "Size: 120 Softgels" / variant heading line. */
  product-info .wk-variant-block-clean .product-form__input > legend,
  product-info .wk-variant-block-clean .product-form__input > .form__label,
  product-info .wk-variant-block-clean .product-form__input .form__label,
  product-info .wk-variant-block-clean variant-radios legend,
  product-info .wk-variant-block-clean variant-selects .form__label,
  product-info .wk-variant-block-clean .variant-picker__label,
  product-info .wk-variant-block-clean .product__variant-label {
    display: none !important;
  }

  /* The app subscription block often adds its own top margin. Remove only that top margin. */
  product-info .wk-subscription-block-clean {
    margin-top: 0 !important;
    padding-top: 0 !important;
  }

  @media screen and (max-width: 749px) {
    product-info {
      --wk-title-review-gap: 8px;
      --wk-review-variant-gap: 12px;
      --wk-variant-subscription-gap: 22px;
    }
  }
</style>

<script>
  (function () {
    function wkGetDirectInfoBlock(el, infoWrapper) {
      if (!el || !infoWrapper) return el;
      while (el.parentElement && el.parentElement !== infoWrapper) {
        el = el.parentElement;
      }
      return el;
    }

    function wkAddClass(el, className) {
      if (el && !el.classList.contains(className)) {
        el.classList.add(className);
      }
    }

    function wkTextIncludes(el, text) {
      return el && (el.textContent || '').toLowerCase().indexOf(text.toLowerCase()) !== -1;
    }

    function wkMatchReferenceLayout() {
      var mainProduct = document.querySelector('product-info[id^="MainProduct-"]');
      if (!mainProduct) return;

      var infoWrapper = mainProduct.querySelector('.product__info-wrapper') || mainProduct;

      var titleEl = infoWrapper.querySelector(
        '[class*="display-title"], [class*="display_title"], .product__title, h1'
      );
      var ratingEl = infoWrapper.querySelector(
        '.jdgm-widget, .jdgm-prev-badge, .product__rating, .rating, [class*="rating"]'
      );
      var variantEl = infoWrapper.querySelector(
        'variant-radios, variant-selects, .product__variant-picker, .variant-picker, .product-form__input'
      );
      var priceEl = infoWrapper.querySelector(
        '.price, .product__price, [data-price], [class*="product-price"]'
      );

      var titleBlock = wkGetDirectInfoBlock(titleEl, infoWrapper);
      var ratingBlock = wkGetDirectInfoBlock(ratingEl, infoWrapper);
      var variantBlock = wkGetDirectInfoBlock(variantEl, infoWrapper);
      var priceBlock = wkGetDirectInfoBlock(priceEl, infoWrapper);

      wkAddClass(titleBlock, 'wk-title-block-clean');
      wkAddClass(ratingBlock, 'wk-review-block-clean');
      wkAddClass(variantBlock, 'wk-variant-block-clean');

      /*
        Mark the direct top price block, but CSS hides only the price number inside it.
        Do NOT hide the whole block, because shipping + Shop Pay terms may be rendered inside it.
      */
      if (priceBlock && priceBlock !== titleBlock && priceBlock !== ratingBlock && priceBlock !== variantBlock) {
        wkAddClass(priceBlock, 'wk-hide-top-price-block');
      }

      /* Detect the subscription module direct block so variant -> subscription spacing is controlled. */
      var candidates = Array.prototype.slice.call(infoWrapper.children || []);
      candidates.forEach(function (block) {
        if (block === titleBlock || block === ratingBlock || block === variantBlock || block === priceBlock) return;
        if (wkTextIncludes(block, 'Subscribe & Save') || wkTextIncludes(block, 'One-Time') || wkTextIncludes(block, 'Deliver Every')) {
          wkAddClass(block, 'wk-subscription-block-clean');
        }
      });
    }

    document.addEventListener('DOMContentLoaded', function () {
      wkMatchReferenceLayout();
      setTimeout(wkMatchReferenceLayout, 500);
      setTimeout(wkMatchReferenceLayout, 1500);
      setTimeout(wkMatchReferenceLayout, 3000);
    });

    document.addEventListener('shopify:section:load', function () {
      wkMatchReferenceLayout();
      setTimeout(wkMatchReferenceLayout, 500);
      setTimeout(wkMatchReferenceLayout, 1500);
    });
  })();
</script>

<style>
  /*
    WK Product payment info cleanup - safe version V3

    Goal:
    1. Hide the visible top price numbers only.
    2. Move the ORIGINAL Shopify shipping + Shop Pay installment component below the purple Shop Pay button.
    3. Keep the original Shopify Learn more behavior / popup.
    4. Hide "More payment options".
    5. Hide only the long Shopify Subscription legal text below the payment button.

    Important:
    Do NOT hide the Price block with the eye icon in the theme editor.
    Keep Price block visible; this code hides only the price number.
    This version also renders a separate native payment terms source, so the Shop Pay Learn more behavior can still work even if the Price block is hidden in the editor.
  */

  /* Hidden source for native Shopify payment terms. Do not display this source directly. */
  .wk-payment-info-source {
    position: absolute !important;
    left: -9999px !important;
    top: auto !important;
    width: 1px !important;
    height: 1px !important;
    overflow: hidden !important;
    opacity: 0 !important;
    pointer-events: none !important;
  }

  .wk-payment-info-source form {
    margin: 0 !important;
    padding: 0 !important;
  }

  .wk-moved-payment-info {
    margin-top: 10px;
    font-size: 14px;
    line-height: 1.45;
  }

  /* Shipping calculated at checkout. - light green, underline only under the shipping text */
  .wk-moved-payment-info .product__tax,
  .wk-moved-payment-info .product__policies {
    display: block !important;
    margin: 0 0 4px 0 !important;
    color: #6ba43a !important;
    font-weight: 500;
    text-decoration: none !important;
  }

  .wk-moved-payment-info .product__tax a,
  .wk-moved-payment-info .product__policies a {
    display: inline !important;
    width: auto !important;
    max-width: none !important;
    color: #6ba43a !important;
    text-decoration: none !important;
    border-bottom: 0 !important;
    line-height: inherit !important;
  }

  .wk-moved-payment-info .wk-shipping-word-link {
    text-decoration: underline !important;
    text-underline-offset: 2px !important;
    text-decoration-thickness: 1px !important;
  }

  /* Shop Pay installment line - dark green */
  .wk-moved-payment-info .shopify-payment-terms,
  .wk-moved-payment-info shopify-payment-terms {
    display: block !important;
    margin: 0 !important;
    color: #0b4f2b !important;
    font-weight: 600;
  }

  .wk-moved-payment-info .shopify-payment-terms *,
  .wk-moved-payment-info shopify-payment-terms * {
    color: #0b4f2b !important;
  }

  .wk-moved-payment-info .shopify-payment-terms a,
  .wk-moved-payment-info shopify-payment-terms a {
    color: #0b4f2b !important;
    text-decoration: underline;
    text-underline-offset: 2px;
  }


  .wk-moved-payment-info .wk-shop-pay-pill {
    display: inline-block;
    margin-left: 2px;
    padding: 0 4px;
    border-radius: 3px;
    background: #5a31f4;
    color: #ffffff !important;
    font-size: 10px;
    line-height: 1.4;
    vertical-align: middle;
  }

  /* Hide More payment options under the purple Shop Pay button */
  .shopify-payment-button__more-options,
  .shopify-payment-button__more-options[aria-hidden="false"],
  .shopify-payment-button__more-options[aria-hidden="true"] {
    display: none !important;
  }

  .wk-hide-subscription-policy {
    display: none !important;
  }
</style>

<script>
  (function () {
    function wkMovePaymentInfoSafe() {
      var mainProduct = document.querySelector('product-info[id^="MainProduct-"]');

      if (!mainProduct) {
        return;
      }

      var productForm =
        mainProduct.querySelector('product-form') ||
        mainProduct.querySelector('.product-form') ||
        mainProduct.querySelector('form[action*="/cart/add"]');

      if (!productForm) {
        return;
      }

      var paymentButton =
        productForm.querySelector('.shopify-payment-button') ||
        mainProduct.querySelector('.shopify-payment-button');

      if (!paymentButton) {
        return;
      }

      var movedBox = mainProduct.querySelector('.wk-moved-payment-info');

      if (!movedBox) {
        movedBox = document.createElement('div');
        movedBox.className = 'wk-moved-payment-info';
        paymentButton.insertAdjacentElement('afterend', movedBox);
      }

      /*
        Use native Shopify-rendered elements.
        Priority 1: original elements from the visible Price block.
        Priority 2: backup native source rendered by this section.
        This keeps the real Shop Pay Learn more behavior instead of fake text.
      */
      var sourceBox = mainProduct.querySelector('.wk-payment-info-source');

      function wkFindOutsideSource(selector) {
        var items = Array.prototype.slice.call(mainProduct.querySelectorAll(selector));
        for (var i = 0; i < items.length; i++) {
          if (movedBox.contains(items[i])) continue;
          if (sourceBox && sourceBox.contains(items[i])) continue;
          return items[i];
        }
        return null;
      }

      function wkFindInsideSource(selector) {
        if (!sourceBox) return null;
        return sourceBox.querySelector(selector);
      }

      var shippingText =
        wkFindOutsideSource('.product__tax, .product__policies') ||
        wkFindInsideSource('.product__tax, .product__policies');

      var shopPayTerms =
        wkFindOutsideSource('shopify-payment-terms, .shopify-payment-terms') ||
        wkFindInsideSource('shopify-payment-terms, .shopify-payment-terms');

      if (shippingText && !movedBox.contains(shippingText)) {
        movedBox.appendChild(shippingText);
      }

      if (shopPayTerms && !movedBox.contains(shopPayTerms)) {
        movedBox.appendChild(shopPayTerms);
      }

      /*
        Safe hide:
        Only hide small paragraph-like elements.
        Do NOT hide div/span containers, otherwise the whole product page may disappear.
      */
      var possiblePolicyTexts = mainProduct.querySelectorAll(
        'p, small, .shopify_subscriptions_app_policy'
      );

      possiblePolicyTexts.forEach(function (el) {
        var text = (el.textContent || '').trim();

        if (
          text.indexOf('This item is a deferred, subscription, or recurring purchase') !== -1 ||
          text.indexOf('By continuing, I agree to the cancellation policy') !== -1
        ) {
          el.classList.add('wk-hide-subscription-policy');
        }
      });
    }

    document.addEventListener('DOMContentLoaded', function () {
      wkMovePaymentInfoSafe();

      setTimeout(wkMovePaymentInfoSafe, 500);
      setTimeout(wkMovePaymentInfoSafe, 1500);
      setTimeout(wkMovePaymentInfoSafe, 3000);
    });

    document.addEventListener('shopify:section:load', function () {
      wkMovePaymentInfoSafe();

      setTimeout(wkMovePaymentInfoSafe, 500);
      setTimeout(wkMovePaymentInfoSafe, 1500);
    });
  })();
